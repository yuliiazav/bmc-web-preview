---
permalink: "/overview/"
---
{% extends "../_includes/index.njk" %}
{# The toggle switch is a macro defined in src/_includes/macros/toggle.njk #}
{% from "macros/toggle.njk" import toggle_switch %}

{% block content %}
    <div class="mx-auto">
        {# Page title #}
        <h1 class="text-[32px] font-medium text-custom-text leading-[130%] tracking-normal mb-2">Overview</h1>

        {# Upper panel with date and time #}
        <div class="bg-white border border-custom-divider rounded-md p-4 mb-14 flex justify-between items-center">
            <div>
                <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">BMC date and Time</p>
                <p class="text-sm font-normal text-custom-text leading-[1.5]">2025-10-14 12:43 UTC</p>
            </div>
            <button class=" bg-brand-blue hover:bg-custom-hover-bg text-white px-8 py-2 rounded-[28px] flex items-center gap-2 transition-all active:scale-95">
                <span class="text-sm font-medium leading-[120%]">SOL console</span>
                <span class="flex items-center justify-center w-2 h-3 shrink-0">
                    {% include "src/assets/icons/icon-arrow-right-bold.svg" %}
                </span>
            </button>
        </div>
        {# TESTING Printed Circuit Board (PCB) code #}
        <div>
            <div class="min-h-screen bg-gray-100 p-8 mb-4 font-sans">
                <div class="max-w-6xl mx-auto">
                    <header class="mb-8 text-center">
                        <h1 class="text-3xl font-extrabold text-gray-900">System Hardware Monitor</h1>
                        <p class="text-gray-600">Interactive PCB Layout &amp; Real-time Status</p>
                    </header>
                    <div class="relative bg-white p-6 rounded-3xl shadow-2xl border border-gray-200">
                        <div class="flex justify-between items-center mb-6">
                            <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2">
                                <span class="flex h-3 w-3 rounded-full bg-green-500"></span>
          Mainboard Live View
                            </h2>
                            <div class="flex gap-3">
                                <button id="btn-fix" class="px-4 py-2 bg-green-600 text-white text-sm font-semibold rounded-lg hover:bg-green-700 transition-all active:scale-95 shadow-md">
            All Systems OK
          </button>
                                <button id="btn-error" class="px-4 py-2 bg-red-600 text-white text-sm font-semibold rounded-lg hover:bg-red-700 transition-all active:scale-95 shadow-md">
            Simulate Critical Error
          </button>
                            </div>
                        </div>

                        <div class="relative overflow-hidden rounded-xl bg-slate-900 p-4">
                            <svg id="server-pcb" class="w-full h-auto" viewBox="0 0 1000 700" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect width="1000" height="700" rx="15" fill="#0F172A"/>
                                <path d="M0 100H1000M0 200H1000M0 300H1000M0 400H1000M0 500H1000M0 600H1000" stroke="#1E293B" stroke-width="1"/>
                                <path d="M100 0V700M200 0V700M300 0V700M400 0V700M500 0V700M600 0V700M700 0V700M800 0V700M900 0V700" stroke="#1E293B" stroke-width="1"/>

                                <g id="cpu-1-group" class="cursor-pointer transition-opacity duration-300" data-info="CPU 1: Intel® Xeon® Silver | Load: 12% | Temp: 40°C">
                                    <rect x="150" y="150" width="200" height="200" rx="10" fill="#1E293B" stroke="#10B981" stroke-width="4"/>
                                    <text x="250" y="260" text-anchor="middle" fill="#94A3B8" font-size="24" font-weight="bold">CPU 1</text>
                                    <circle cx="330" cy="170" r="8" fill="#10B981"/>
                                </g>

                                <g id="cpu-2-group" class="cursor-pointer transition-opacity duration-300" data-info="CPU 2: Intel® Xeon® Silver | Load: 0% | Temp: --">
                                    <rect id="cpu-2-socket" x="150" y="400" width="200" height="200" rx="10" fill="#1E293B" stroke="#334155" stroke-width="4"/>
                                    <text id="cpu-2-label" x="250" y="510" text-anchor="middle" fill="#94A3B8" font-size="24" font-weight="bold">CPU 2</text>
                                    <circle id="cpu-2-status" cx="330" cy="420" r="8" fill="#334155"/>
                                </g>

                                <g id="ram-slots">
                                    <rect x="450" y="150" width="15" height="200" rx="2" fill="#334155" class="cursor-pointer" data-info="DIMM A1: 32GB DDR4 | Status: OK"/>
                                    <rect x="475" y="150" width="15" height="200" rx="2" fill="#334155" class="cursor-pointer" data-info="DIMM A2: 32GB DDR4 | Status: OK"/>
                                    <rect x="500" y="150" width="15" height="200" rx="2" fill="#334155" stroke="#F59E0B" stroke-width="2" class="cursor-pointer" data-info="DIMM A3: Bad ECC | Status: Warning"/>
                                </g>

                                <g id="temp-sensor" class="animate-pulse cursor-pointer" data-info="Test Sensor: Inlet Temp | Value: 24°C">
                                    <circle cx="850" cy="150" r="15" fill="#10B981" fill-opacity="0.2" stroke="#10B981" stroke-width="2"/>
                                    <circle cx="850" cy="150" r="5" fill="#10B981"/>
                                </g>

                                <rect x="750" y="450" width="200" height="150" rx="10" fill="#1E293B" stroke="#475569" stroke-width="2" class="cursor-pointer" data-info="PSU 1: 750W Hot-swap | Efficiency: 94%"/>
                                <text x="850" y="535" text-anchor="middle" fill="#475569" font-size="16">POWER SUPPLY</text>
                            </svg>

                            <div id="pcb-tooltip" class="absolute hidden bg-slate-800 text-white text-xs font-medium px-3 py-2 rounded-md shadow-xl border border-slate-600 pointer-events-none z-50 transition-opacity duration-200">
                                <div id="tooltip-content"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <script>
                // 1. Our system state data (This is from JSON or API)
                let systemState = [
                    {
                        id: 'cpu-1-group',
                        name: 'CPU 1',
                        status: 'ok',
                        info: 'Intel Xeon | Temp: 40°C'
                    }, {
                        id: 'cpu-2-group',
                        name: 'CPU 2',
                        status: 'default',
                        info: 'Intel Xeon | Idle'
                    }, {
                        id: 'dimm-a3',
                        name: 'DIMM A3',
                        status: 'warning',
                        info: 'Bad ECC | Status: Warning'
                    }, {
                        id: 'temp-sensor',
                        name: 'Sensor',
                        status: 'pulse',
                        info: 'Ambient: 24°C'
                    }
                ];

                // Styes configuration based on status
                const statusStyles = {
                    ok: {
                        stroke: '#10B981',
                        fill: '#10B981',
                        pulse: false
                    },
                    warning: {
                        stroke: '#F59E0B',
                        fill: '#F59E0B',
                        pulse: false
                    },
                    error: {
                        stroke: '#EF4444',
                        fill: '#EF4444',
                        pulse: true
                    },
                    pulse: {
                        stroke: '#10B981',
                        fill: '#10B981',
                        pulse: true
                    },
                    default: {
                        stroke: '#334155',
                        fill: '#334155',
                        pulse: false
                    }
                };

                // 2. Update function to update PCB elements based on systemState
                function updatePCB() {
                    systemState.forEach(item => {
                        const el = document.getElementById(item.id);
                        if (!el) 
                            return;
                        
                        const style = statusStyles[item.status];

                        // Update stroke and fill for all shapes inside the group
                        const shapes = el.querySelectorAll('rect, circle, path');
                        shapes.forEach(shape => {
                            shape.setAttribute('stroke', style.stroke);
                            if (shape.tagName !== 'rect') 
                                shape.setAttribute('fill', style.fill);
                            }
                        );

                        // animation for critical status
                        if (style.pulse) 
                            el
                                .classList
                                .add('animate-pulse');
                        else 
                            el
                                .classList
                                .remove('animate-pulse');
                        
                        // Update tooltip info
                        el.setAttribute('data-info', `${item.name}: ${item.info}`);
                    });
                }

                // 3. Update event listeners for buttons (now they just change the data)
                document
                    .getElementById('btn-error')
                    .addEventListener('click', () => {
                        // find the CPU 2 item in our state and update it to error
                        const cpu2 = systemState.find(i => i.id === 'cpu-2-group');
                        cpu2.status = 'error';
                        cpu2.info = 'OVERHEAT! Temp: 98°C';
                        updatePCB();
                    });

                document
                    .getElementById('btn-fix')
                    .addEventListener('click', () => {
                        systemState = systemState.map(item => ({
                            ...item,
                            status: 'ok'
                        }));
                        updatePCB();
                    });

                // Tooltip initialization
                const tooltip = document.getElementById('pcb-tooltip');
                document
                    .querySelectorAll('[data-info]')
                    .forEach(el => {
                        el.addEventListener('mousemove', (e) => {
                            const rect = document
                                .getElementById('server-pcb')
                                .getBoundingClientRect();
                            tooltip
                                .classList
                                .remove('hidden');
                            tooltip.innerHTML = el.getAttribute('data-info');
                            tooltip.style.left = (e.clientX - rect.left + 20) + 'px';
                            tooltip.style.top = (e.clientY - rect.top + 20) + 'px';
                        });
                        el.addEventListener('mouseleave', () => tooltip.classList.add('hidden'));
                    });

                //initial render
                updatePCB();
            </script>
        </div>
        {# / TESTING - end of  Printed Circuit Board (PCB) code#}

        {# Section: System information #}
        <section class="mb-14">
            <h2 class="text-xl font-medium text-custom-text leading-[130%] mb-4">System information</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">

                {# Card: BMC Date and Time #}
                <div class="bg-white border border-custom-divider rounded-md overflow-hidden">
                    <div class="flex justify-between items-center px-4 py-3 border-b border-custom-divider">
                        <span class="text-sm font-medium text-custom-text leading-[1.5]">BMC date and Time</span>
                        <a href="#" class="text-sm font-medium text-brand-blue leading-[120%] hover:underline transition-all">View more</a>
                    </div>
                    <div class="px-4 py-3 grid grid-cols-2 gap-x-4 gap-y-3">
                        <div>
                            <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">Model</p>
                            <p class="text-sm font-normal text-custom-text leading-[1.5]">--</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">Server manufacturer</p>
                            <p class="text-sm font-normal text-custom-text leading-[1.5]">--</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">Serial number</p>
                            <p class="text-sm font-normal text-custom-text leading-[1.5]">--</p>
                        </div>
                    </div>
                </div>

                {# Card: Firmware information #}
                <div class="bg-white border border-custom-divider rounded-md overflow-hidden">
                    <div class="flex justify-between items-center px-4 py-3 border-b border-custom-divider">
                        <span class="text-sm font-medium text-custom-text leading-[1.5]">Firmware information</span>
                        <a href="#" class="text-sm font-medium text-brand-blue leading-[120%] hover:underline transition-all">View more</a>
                    </div>
                    <div class="px-4 py-3 grid grid-cols-2 gap-x-4 gap-y-3">
                        <div class="col-span-1">
                            <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">Running</p>
                            <p class="text-sm font-normal text-custom-text leading-[1.5] truncate">v09.05-21-ge66c49cdfe-dirty</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">Firmware version</p>
                            <p class="text-sm font-normal text-custom-text leading-[1.5]">--</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">Backup</p>
                            <p class="text-sm font-normal text-custom-text leading-[1.5]">--</p>
                        </div>
                    </div>
                </div>

                {# Card: Network information #}
                <div class="bg-white border border-custom-divider rounded-md overflow-hidden">
                    <div class="flex justify-between items-center px-4 py-3 border-b border-custom-divider">
                        <span class="text-sm font-medium text-custom-text leading-[1.5]">Network information</span>
                        <a href="#" class="text-sm font-medium text-brand-blue leading-[120%] hover:underline transition-all">View more</a>
                    </div>
                    <div class="px-4 py-3 grid grid-cols-2 gap-x-4 gap-y-3">
                        <div>
                            <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">Hostname</p>
                            <p class="text-sm font-normal text-custom-text leading-[1.5]">ast2600-default</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">Link status</p>
                            <p class="text-sm font-normal text-custom-text leading-[1.5]">NoLink</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">IPv4</p>
                            <p class="text-sm font-normal text-custom-text leading-[1.5]">--</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">DHCPv4</p>
                            <p class="text-sm font-normal text-custom-text leading-[1.5]">--</p>
                        </div>
                    </div>
                </div>

                {# Card: Power information #}
                <div class="bg-white border border-custom-divider rounded-md overflow-hidden">
                    <div class="flex justify-between items-center px-4 py-3 border-b border-custom-divider">
                        <span class="text-sm font-medium text-custom-text leading-[1.5]">Power information</span>
                        <a href="#" class="text-sm font-medium text-brand-blue leading-[120%] hover:underline transition-all">View more</a>
                    </div>
                    <div class="px-4 py-3 flex flex-col gap-y-3">
                        <div>
                            <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">Power consumption</p>
                            <p class="text-sm font-normal text-custom-text leading-[1.5]">Not available</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">Power cap</p>
                            <p class="text-sm font-normal text-custom-text leading-[1.5]">Disabled</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {# Section: Status information #}
        <section class="mb-[62px]">
            <h2 class="text-xl font-medium text-custom-text leading-[130%] mb-4">Status information</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                {# Card: Event logs #}
                <div class="bg-white border border-custom-divider rounded-md overflow-hidden">
                    <div class="flex justify-between items-center px-4 py-3 border-b border-custom-divider">
                        <span class="text-sm font-medium text-custom-text leading-[1.5]">Event logs</span>
                        <div class="flex items-center gap-2">
                            <a href="#" class="text-sm font-medium text-brand-blue leading-[120%] hover:underline transition-all">Export All</a>
                            <div class="w-[1px] h-[21px] bg-custom-divider"></div>
                            <a href="#" class="text-sm font-medium text-brand-blue leading-[120%] hover:underline transition-all">View more</a>
                        </div>
                    </div>
                    <div class="px-4 py-3 grid grid-cols-2 gap-x-4">
                        <div>
                            <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">Critical</p>
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-normal text-custom-text">12</span>
                                <span class="flex items-center justify-center w-4 h-4 shrink-0">
                                    {% include "src/assets/icons/icon-health-red.svg" %}
                                </span>
                            </div>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">Warning</p>
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-normal text-custom-text">36</span>
                                <span class="flex items-center justify-center w-4 h-4 shrink-0">
                                    {% include "src/assets/icons/icon-warning-rounded.svg" %}
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                {# Card: Inventory and LEDs #}
                <div class="bg-white border border-custom-divider rounded-md overflow-hidden">
                    <div class="flex justify-between items-center px-4 py-3 border-b border-custom-divider">
                        <span class="text-sm font-medium text-custom-text leading-[1.5]">Inventory and LEDs</span>
                        <a href="#" class="text-sm font-medium text-brand-blue leading-[120%] hover:underline transition-all">View more</a>
                    </div>
                    <div class="px-4 py-3">
                        <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">System identify LED</p>
                        {# Toggle switch #}
                        {{ toggle_switch(id="identifyLedToggle", label_text="Off", checked=false) }}
                    </div>
                </div>

            </div>
        </section>
    </div>
{% endblock %}