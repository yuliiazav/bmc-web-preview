---
permalink: "/"
---
{% extends "../_includes/index.njk" %}
{# The toggle switch is a macro defined in src/_includes/macros/toggle.njk #}
{% from "macros/toggle.njk" import toggle_switch %}

{% block content %}
    <div class="mx-auto">
        {# Page title #}
        <h1 class="text-[32px] font-medium text-custom-text leading-[130%] tracking-normal mb-2">Overview</h1>

        {# Upper panel with date and time #}
        <div class="bg-white border border-custom-divider rounded-md p-4 mb-14 flex justify-between items-center">
            <div>
                <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">IPDesk date and Time</p>
                <p id="val-ipdesk-date-time" class="text-sm font-normal text-custom-text leading-[1.5]">2025-10-14 12:43 UTC</p>
            </div>
            <a href="/sol-console/" id="link-open-sol-console" 
              class="bg-brand-blue hover:bg-custom-hover-bg text-white px-8 py-2 rounded-[28px] flex items-center gap-2 transition-all active:scale-95 w-fit">
                <span class="text-sm font-medium leading-[120%]">SOL console</span>
                <span class="flex items-center justify-center w-2 h-3 shrink-0">
                    {% include "src/assets/icons/icon-arrow-right-bold.svg" %}
                </span>
            </a>
        </div>

        {# Section: System information #}
        <section class="mb-14">
            <h2 class="text-xl font-medium text-custom-text leading-[130%] mb-4">System information</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">

                {# Card: IPDesk Date and Time #}
                <article id="card-ipdesk-info" class="bg-white border border-custom-divider rounded-md overflow-hidden">
                    <div class="flex justify-between items-center px-4 py-3 border-b border-custom-divider">
                        <span class="text-sm font-medium text-custom-text leading-[1.5]">IPDesk date and Time</span>
                        <a href="/date-and-time/" id="link-view-more-ipdeskDate" class="text-sm font-medium text-brand-blue leading-[120%] hover:underline transition-all">View more</a>
                    </div>
                    <div class="px-4 py-3 grid grid-cols-2 gap-x-4 gap-y-3">
                        <div>
                            <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">Model</p>
                            <p id="val-info-model" class="text-sm font-normal text-custom-text leading-[1.5]">--</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">Server manufacturer</p>
                            <p id="val-info-manufacturer" class="text-sm font-normal text-custom-text leading-[1.5]">--</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">Serial number</p>
                            <p id="val-info-serial" class="text-sm font-normal text-custom-text leading-[1.5]">--</p>
                        </div>
                    </div>
                </article>

                {# Card: Firmware information #}
                <article id="card-firmware-info" class="bg-white border border-custom-divider rounded-md overflow-hidden">
                    <div class="flex justify-between items-center px-4 py-3 border-b border-custom-divider">
                        <span class="text-sm font-medium text-custom-text leading-[1.5]">Firmware information</span>
                        <a href="/firmware/" id="link-view-more-firmware" class="text-sm font-medium text-brand-blue leading-[120%] hover:underline transition-all">View more</a>
                    </div>
                    <div class="px-4 py-3 grid grid-cols-2 gap-x-4 gap-y-3">
                        <div class="col-span-1">
                            <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">Running</p>
                            <p id="val-firmware-running" class="text-sm font-normal text-custom-text leading-[1.5] truncate">v09.05-21-ge66c49cdfe-dirty</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">Firmware version</p>
                            <p id="val-firmware-version" class="text-sm font-normal text-custom-text leading-[1.5]">--</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">Backup</p>
                            <p id="val-firmware-backup" class="text-sm font-normal text-custom-text leading-[1.5]">--</p>
                        </div>
                    </div>
                </article>

                {# Card: Network information #}
                <article id="card-network-info" class="bg-white border border-custom-divider rounded-md overflow-hidden">
                    <div class="flex justify-between items-center px-4 py-3 border-b border-custom-divider">
                        <span class="text-sm font-medium text-custom-text leading-[1.5]">Network information</span>
                        <a href="/network/" id="link-view-more-network" class="text-sm font-medium text-brand-blue leading-[120%] hover:underline transition-all">View more</a>
                    </div>
                    <div class="px-4 py-3 grid grid-cols-2 gap-x-4 gap-y-3">
                        <div>
                            <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">Hostname</p>
                            <p id="val-network-hostname" class="text-sm font-normal text-custom-text leading-[1.5]">ast2600-default</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">Link status</p>
                            <p id="val-network-link-status" class="text-sm font-normal text-custom-text leading-[1.5]">NoLink</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">IPv4</p>
                            <p id="val-network-ipv4" class="text-sm font-normal text-custom-text leading-[1.5]">--</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">DHCPv4</p>
                            <p id="val-network-dhcpv4" class="text-sm font-normal text-custom-text leading-[1.5]">--</p>
                        </div>
                    </div>
                </article>
            </div>
        </section>

    </div>
{% endblock %}