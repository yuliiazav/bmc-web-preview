---
permalink: "/sensors/"
---

{% extends "../../_includes/index.njk" %}
{% from "macros/status.njk" import status_badge %}
{% from "macros/search.njk" import search_input %}
{% block content %}
    <div class="mx-auto">
        <h1 class="text-[32px] font-medium text-[#1D1D1F] leading-[130%] tracking-normal mb-7">Sensors</h1>
        <div class="flex justify-between items-center mb-3 pr-2">
            {# Search #}
            {{ search_input(id="sensorSearch", placeholder="Search sensors") }}
            {# Filter #}
            <div class="relative inline-block">
                <input type="checkbox" id="filter-menu-toggle" class="peer hidden"/>
                <label
                    for="filter-menu-toggle"
                    class="flex items-center gap-2 text-custom-text cursor-pointer select-none hover:text-brand-blue transition-colors
                        peer-checked:text-[#6090C2]">
                    <span>{%include "../../assets/icons/icon-filter.svg" %}</span>
                    <span class="text-md font-normal leading-none tracking-normal">Filter</span>
                </label>
                <div class="hidden peer-checked:flex absolute right-0 mt-2 w-[180px] flex-col bg-white rounded-[20px] shadow z-50 p-4 gap-2">
                    <span class="text-sm font-normal text-custom-text leading-[21px] tracking-normal">Status</span>
                    <div class="flex flex-col gap-2">
                        <label class="flex items-center gap-2 cursor-pointer group">
                            <input type="checkbox" class="w-4 h-4 rounded border-custom-border cursor-pointer"/>
                            <span class="text-[12px] leading-[21px] font-normal text-custom-text group-hover:text-black">OK</span>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer group">
                            <input type="checkbox" class="w-4 h-4 rounded border-custom-border cursor-pointer"/>
                            <span class="text-[12px] leading-[21px] font-normal text-custom-text group-hover:text-black">Warning</span>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer group">
                            <input type="checkbox" class="w-4 h-4 rounded border-custom-border cursor-pointer"/>
                            <span class="text-[12px] leading-[21px] font-normal text-custom-text group-hover:text-black">Critical</span>
                        </label>
                    </div>
                    <button type="button" class="text-left text-[12px] leading-[18px] font-normal text-[#6090C2] hover:underline mt-2">
                        Clear all
                    </button>
                </div>

            </div>
        </div>
        <div class="bg-white border border-custom-divider overflow-hidden">
            <table class="w-full text-left border-collapse">
                <thead class="bg-custom-light-bg border-b border-custom-divider">
                    <tr>
                        <th class="px-2 py-5 w-12 text-center">
                            <input type="checkbox" class="w-4 h-4 rounded border-custom-border"/>
                        </th>
                        <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Name</th>
                        <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Status</th>
                        <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Lower critical</th>
                        <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Lower warning</th>
                        <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Current value</th>
                        <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Upper warning</th>
                        <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Upper critical</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#E0E0E0]">
                    <tr class="hover:bg-custom-aside-bg transition-colors">
                        <td class="px-2 py-4 text-center">
                            <input type="checkbox" class="w-4 h-4 rounded border-custom-border"/>
                        </td>
                        <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">ADC0 12V</td>
                        <td class="px-4 py-4">
                            {{ status_badge('Critical') }}
                        </td>
                        <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">10.2 V</td>
                        <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">10.8 V</td>
                        <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">8.31 V</td>
                        <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">13.2 V</td>
                        <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">13.8 V</td>
                    </tr>
                    <tr class="hover:bg-custom-aside-bg transition-colors">
                        <td class="px-2 py-4 text-center">
                            <input type="checkbox" class="w-4 h-4 rounded border-custom-border"/>
                        </td>
                        <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">ABCB 12V</td>
                        <td class="px-4 py-4">
                            {{ status_badge('Critical') }}
                        </td>
                        <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">1.2 V</td>
                        <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">1.8 V</td>
                        <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">8.31 V</td>
                        <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">13.2 V</td>
                        <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">1.8 V</td>
                    </tr>
                    <tr class="hover:bg-custom-aside-bg transition-colors">
                        <td class="px-2 py-4 text-center">
                            <input type="checkbox" class="w-4 h-4 rounded border-custom-border"/>
                        </td>
                        <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">Battery</td>
                        <td class="px-4 py-4">
                            {{ status_badge('Critical') }}
                        </td>
                        <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">10.2 V</td>
                        <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">10.8 V</td>
                        <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">8.31 V</td>
                        <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">13.2 V</td>
                        <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">13.8 V</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}