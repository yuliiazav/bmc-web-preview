---
permalink: "/inventory-and-leds/"
---

{% extends "../../_includes/index.njk" %}
{% from "macros/status.njk" import status_badge %}
{% from "macros/search.njk" import search_input %}
{# The toggle switch is a macro defined in src/_includes/macros/toggle.njk #}
{% from "macros/toggle.njk" import toggle_switch %}

{% block content %}
    <div class="mx-auto">
        <h1 class="text-[32px] font-medium text-black  leading-[130%] tracking-normal mb-9">Inventory and LEDs</h1>
        <div class="mb-14">
            <h2 class="text-xl font-medium text-black  leading-[130%] mb-4">LED light control</h2>
            <div class="bg-white border border-custom-divider rounded-md p-4 flex gap-[210px]">
                <div>
                    <span class="block text-sm font-medium text-custom-text leading-[1.5] mb-1">Power status</span>
                    <span class="text-sm font-normal text-custom-text leading-[21px] tracking-normal">Off</span>
                </div>
                <div>
                    <span class="block text-sm font-medium text-custom-text leading-[1.5] mb-1">System identify LED</span>
                    {# Toggle switch #}
                    {{ toggle_switch(id="sysIdentifyLedToggle", label_text="Off", checked=false) }}
                </div>
            </div>
        </div>
        <div class="mb-12">
            <h2 class="text-xl font-medium text-black leading-[130%] mb-4">Quick links to hardware components</h2>
            <div class="flex gap-4 overflow-x-auto pb-2">
                {% set components = [
                          { name: 'System', iconPath: '../../assets/icons/icon-hardware.svg', color: '#2B7FFF' },
                          { name: 'Power Supplies', iconPath: '../../assets/icons/icon-power.svg', color: '#FE9A00' },
                          { name: 'Processors', iconPath: '../../assets/icons/icon-processor.svg', color: '#AD46FF' },
                          { name: 'DIMM Slot', iconPath: '../../assets/icons/icon-dmmSlot.svg', color: '#00BBA7' },
                          { name: 'Chassis', iconPath: '../../assets/icons/icon-cube.svg', color: '#6A7282' },
                          { name: 'BMC Manager', iconPath: '../../assets/icons/icon-settings.svg', color: '#615FFF' },
                          { name: 'Fans', iconPath: '../../assets/icons/icon-fan.svg', color: '#20C1DF' },
                          { name: 'Assemblies', iconPath: '../../assets/icons/icon-resource.svg', color: '#00C950' }
                 ] %}
                {% for item in components %}
                    <div class="flex-1 bg-white border border-[#ebebed87] rounded-[16px] p-3 flex flex-col items-center justify-center gap-3
                    shadow cursor-pointer hover:border-brand-blue transition-colors">
                        <span class="flex items-center justify-center w-6 h-6 shrink-0" style="color: {{ item.color }}">
                            {% include item.iconPath %}
                        </span>
                        <span class="text-sm font-medium text-custom-text leading-[1.5] text-center">{{ item.name }}</span>
                    </div>
                {% endfor %}
            </div>
        </div>
        <div class="mb-14">
            <h2 class="text-xl font-medium text-black leading-[130%] mb-4">System</h2>
            <div class="bg-white border border-custom-divider overflow-hidden">
                <table class="w-full text-left border-collapse">
                    <thead class=" bg-custom-light-bg border-b border-custom-divider">
                        <tr>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">ID</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Hardware type</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Health</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Location number</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Identify LED</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-custom-divider">
                        <tr>
                            <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">SYS02</td>
                            <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">Mainboard</td>
                            <td class="px-4 py-4">
                                {{ status_badge('Warning') }}
                            </td>
                            <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">Slot #3</td>
                            <td class="px-4 py-4">
                                {# Toggle switch #}
                                {{ toggle_switch(id="ledToggle", label_text="Off", checked=false) }}
                            </td>
                        </tr>
                        <tr>
                            <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">SYS02</td>
                            <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">GPU Expansion Board</td>
                            <td class="px-4 py-4">
                                {{ status_badge('Ok') }}
                            </td>
                            <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">Slot #1</td>
                            <td class="px-4 py-4">
                                {# Toggle switch #}
                                {{ toggle_switch(id="ledToggle", label_text="On", checked=true) }}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mb-14">
            <h2 class="text-xl font-medium text-black leading-[130%] mb-4">BMC manager</h2>
            <div class="bg-white border border-custom-divider overflow-hidden">
                <table class="w-full text-left border-collapse">
                    <thead class=" bg-custom-light-bg border-b border-custom-divider">
                        <tr>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">ID</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Health</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Location number</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Identify LED</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-custom-divider">
                        <tr>
                            <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">BMC-01</td>
                            <td class="px-4 py-4">
                                {{ status_badge('Ok') }}
                            </td>
                            <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">Controller 0</td>
                            <td class="px-4 py-4">
                                {# Toggle switch #}
                                {{ toggle_switch(id="ledToggle", label_text="Off", checked=false) }}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mb-14">
            <h2 class="text-xl font-medium text-black leading-[130%] mb-4">Chassis</h2>
            {# Search #}
            {{ search_input(id="chassisSearch", placeholder="Search chassis") }}

            <div class="bg-white border border-custom-divider overflow-hidden">
                <table class="w-full text-left border-collapse">
                    <thead class=" bg-custom-light-bg border-b border-custom-divider">
                        <tr>
                            <th class="px-4 py-5 w-10"></th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">ID</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Health</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Location number</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Identify LED</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-custom-divider">
                        <tr>
                            <td class="px-4 py-4 text-center align-middle">
                                <span class="material-symbols-outlined text-[#707070] text-[24px] cursor-pointer">keyboard_arrow_down</span>
                            </td>
                            <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">AST2600_EVB</td>
                            <td class="px-4 py-4">
                                {{ status_badge('Warning') }}
                            </td>
                            <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">Rack A-12</td>
                            <td class="px-4 py-4">
                                {# Toggle switch #}
                                {{ toggle_switch(id="ledToggle", label_text="Off", checked=false) }}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mb-14">
            <h2 class="text-xl font-medium text-black leading-[130%] mb-4">DIMM Slot</h2>
            {# Search #}
            {{ search_input(id="dimmSlotSearch", placeholder="Search dimm slots") }}

            <div class="bg-white border border-custom-divider overflow-hidden">
                <table class="w-full text-left border-collapse">
                    <thead class=" bg-custom-light-bg border-b border-custom-divider">
                        <tr>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">ID</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Health</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">State</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Location number</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Identify LED</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-custom-divider">
                        <tr>
                            <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">AST2600_EVB</td>
                            <td class="px-4 py-4">
                                {{ status_badge('Ok') }}
                            </td>
                            <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">Active – 16 GB DDR4</td>
                            <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">Slot A1</td>
                            <td class="px-4 py-4">
                                {# Toggle switch #}
                                {{ toggle_switch(id="ledToggle", label_text="On", checked=true) }}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mb-14">
            <h2 class="text-xl font-medium text-black leading-[130%] mb-4">Fans</h2>
            {# Search #}
            {{ search_input(id="fanSearch", placeholder="Search fans") }}

            <div class="bg-white border border-custom-divider overflow-hidden">
                <table class="w-full text-left border-collapse">
                    <thead class=" bg-custom-light-bg border-b border-custom-divider">
                        <tr>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Name</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Health</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Part number</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Serial number</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-custom-divider">
                        <tr>
                            <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">FAN-1</td>
                            <td class="px-4 py-4">
                                {{ status_badge('Critical') }}
                            </td>
                            <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">FAN-X92-A</td>
                            <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">SN-FAN-4820</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mb-14">
            <h2 class="text-xl font-medium text-black leading-[130%] mb-4">Power Supplies</h2>
            {# Search #}
            {{ search_input(id="powerSupplySearch", placeholder="Search power supplies") }}

            <div class="bg-white border border-custom-divider overflow-hidden">
                <table class="w-full text-left border-collapse">
                    <thead class=" bg-custom-light-bg border-b border-custom-divider">
                        <tr>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">ID</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Health</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Location number</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Identify LED</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-custom-divider">
                        <tr>
                            <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">PSU-1</td>
                            <td class="px-4 py-4">
                                {{ status_badge('Warning') }}
                            </td>
                            <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">Bay #1</td>
                            <td class="px-4 py-4">
                                {# Toggle switch #}
                                {{ toggle_switch(id="ledToggle", label_text="Off", checked=false) }}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mb-14">
            <h2 class="text-xl font-medium text-black leading-[130%] mb-4">Processors</h2>
            {# Search #}
            {{ search_input(id="processorSearch", placeholder="Search processors") }}

            <div class="bg-white border border-custom-divider overflow-hidden">
                <table class="w-full text-left border-collapse">
                    <thead class=" bg-custom-light-bg border-b border-custom-divider">
                        <tr>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">ID</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Health</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">State</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Location number</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Identify LED</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-custom-divider">
                        <tr>
                            <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">CPU-1</td>
                            <td class="px-4 py-4">
                                {{ status_badge('Ok') }}
                            </td>
                            <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">Active – 3.2GHz</td>
                            <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">Socket A</td>
                            <td class="px-4 py-4">
                                {# Toggle switch #}
                                {{ toggle_switch(id="ledToggle", label_text="On", checked=true) }}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mb-[30px]">
            <h2 class="text-xl font-medium text-black leading-[130%] mb-4">Assemblies</h2>
            <div class="bg-white border border-custom-divider overflow-hidden">
                <table class="w-full text-left border-collapse">
                    <thead class=" bg-custom-light-bg border-b border-custom-divider">
                        <tr>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">ID</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Part number</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Location number</th>
                            <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none tracking-normal">Identify LED</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-custom-divider">
                        <tr>
                            <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">ASM-CTRL-01</td>
                            <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">P/N-8421-CTRL</td>
                            <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3] tracking-normal">Frame #A2</td>
                            <td class="px-4 py-4">
                                {# Toggle switch #}
                                {{ toggle_switch(id="ledToggle", label_text="Off", checked=false) }}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}