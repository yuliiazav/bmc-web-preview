---
permalink: /certificates/
---
{% extends "../../_includes/index.njk" %}

{% block content %}
    <div class="mx-auto">
        <div class="flex justify-between items-center">
            <h1 class="text-[32px] font-medium text-custom-text leading-[130%]">Certificates</h1>

            <div class="flex gap-4">
                <button id="generate-csr-btn" class="flex items-center gap-2 text-sm text-brand-blue hover:text-custom-accent font-medium">
                    <span class="w-4 h-4">{% include "src/assets/icons/icon-plus.svg" %}</span>
                Generate CSR
            </button>

                <button id="add-cert-btn" class="flex items-center gap-2 px-4 py-2.5 bg-brand-blue text-white text-sm font-medium rounded-[28px] hover:bg-custom-hover-bg transition-all active:scale-95">
                    <span class="w-4 h-4">{% include "src/assets/icons/icon-plus.svg" %}</span>
                Add new certificate
            </button>
            </div>
        </div>

        <div class="bg-white border border-custom-divider rounded-xl overflow-hidden shadow-sm mt-8">
            <table class="w-full text-left border-collapse text-sm">
                <thead class="bg-custom-light-bg border-b border-custom-divider text-custom-text">
                    <tr>
                        <th class="p-4 font-medium">Certificate</th>
                        <th class="p-4 font-medium">Issued by</th>
                        <th class="p-4 font-medium">Issued to</th>
                        <th class="p-4 font-medium">Valid from</th>
                        <th class="p-4 font-medium">Valid until</th>
                        <th class="p-4 font-medium w-[150px]"></th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="empty-row hidden border-b border-custom-divider">
                        <td colspan="6" class="p-12 text-center text-stone-700 italic bg-white">
                    No items available
                </td>
                    </tr>
                    <tr class="border-b border-custom-divider hover:bg-gray-50 transition-colors">
                        <td class="px-4 py-4 font-normal text-custom-text">HTTPS Certificate</td>
                        <td class="px-4 py-4 font-normal text-custom-text">testhost</td>
                        <td class="px-4 py-4 font-normal text-custom-text">testhost</td>
                        <td class="px-4 py-4 font-normal text-custom-text text-nowrap">2026-02-21</td>
                        <td class="px-4 py-4 font-normal text-custom-text text-nowrap">2036-02-21</td>
                        <td class="px-4 py-4">
                            <div class="flex items-center justify-center gap-2">

                                {# Button: Replace Certificate #}
                                <div class="relative group">
                                    <button id="btn-replace-cert" class="p-2 text-brand-blue hover:bg-brand-blue/10 rounded-lg transition-all active:scale-90">
                                        {% include "src/assets/icons/icon-refresh.svg" %}
                                    </button>
                                    <span class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block w-max px-2 py-1 bg-custom-text/60 text-white text-[10px] rounded shadow-lg z-20">
                                Replace certificate
                                <span class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-custom-text"></span>
                                    </span>
                                </div>

                                {# Button: Delete Certificate #}
                                <div class="relative group">
                                    <button id="id-delete-cert" class="p-2 text-custom-aside-text hover:text-red-500 hover:bg-red-50 rounded-lg transition-all active:scale-90">
                                        {% include "src/assets/icons/icon-trash.svg" %}
                                    </button>
                                    <span class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block w-max px-2 py-1 bg-custom-text/60 text-white text-[10px] rounded shadow-lg z-20">
                                Delete certificate
                                <span class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-custom-text"></span>
                                    </span>
                                </div>

                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    {# Modal for Add certificate btn #}
    <div id="modal-add-certificate" class="fixed inset-0 z-[100] hidden flex items-center justify-center bg-black/50 backdrop-blur-sm px-4">
        <div class="bg-white rounded-[16px] shadow-2xl w-full max-w-[540px] overflow-hidden transition-all">

            <div class="px-6 py-4 border-b border-custom-divider flex justify-between items-center bg-custom-light-bg">
                <h3 class="text-lg font-bold text-custom-text">Add new certificate</h3>
                <button class="modal-close text-custom-aside-text hover:text-custom-text text-2xl leading-none">&times;</button>
            </div>

            <div class="p-8">
                <form>
                    <div role="group" class="flex flex-col gap-2 mb-6">
                        <label for="certificate-type" class="text-xs font-medium text-custom-text">Certificate type</label>
                        <div class="relative">
                            <select id="certificate-type" class="w-full px-4 py-3 border border-custom-divider rounded-lg text-sm focus:border-brand-blue outline-none bg-white cursor-pointer">
                                <option value="LDAP Certificate">LDAP Certificate</option>
                                <option value="TrustStore Certificate">CA Certificate</option>
                            </select>
                        </div>
                    </div>

                    {# Certificate File Fieldset #}
                    <fieldset class="border-none p-0 m-0">
                        <legend class="text-xs font-medium text-custom-text mb-2">Certificate file</legend>
                        <div class="custom-form-file-container">
                            <label class="relative flex flex-col gap-2 cursor-pointer">
                                {# Hidden real file input #}
                                <input type="file" id="certificate-file" accept=".pem" class="sr-only peer">

                                {#  "Add file" button #}
                                <span class="add-file-btn inline-block w-fit px-6 py-2 bg-custom-light-bg hover:bg-custom-text/10 text-custom-text border border-custom-divider hover:border-custom-aside-text text-sm font-medium rounded-md hover:bg-opacity-90 transition-all active:scale-95 text-center">
                                Add file
                            </span>

                                {# File name display #}
                                <span id="file-name-display" class="text-xs text-custom-aside-text italic mt-1">No file chosen</span>

                                <div role="alert" class="invalid-feedback hidden text-red-500 text-[10px] mt-1">
                                Required
                            </div>
                            </label>
                        </div>
                    </fieldset>
                </form>
            </div>

            <div class="px-6 py-4 bg-custom-light-bg border-t border-custom-divider flex justify-end gap-3">
                <button class="modal-close px-6 py-2 text-sm font-medium bg-custom-text/30 text-white rounded-full hover:bg-custom-text/50 transition-all active:scale-95">Cancel</button>
                <button id="btn-submit-cert" class="px-8 py-2.5 bg-brand-blue hover:bg-custom-hover-bg text-white text-sm font-medium rounded-full shadow-md transition-all active:scale-95">Add</button>
            </div>
        </div>
    </div>
    {# Modal for Generate CSR btn #}
