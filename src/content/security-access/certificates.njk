                                <label for="alternate-name" class="block text-[12px] font-medium text-custom-text mb-0.5">Alternate name 
                                    <span class="text-custom-aside-text italic font-normal">(optional). </span>
                                    <span class="text-[11px] text-custom-aside-text italic font-normal">Add multiple alternate names separated by space</span></label>
                                <input id="alternate-name" type="text" class="w-full px-3 py-1.5 border border-custom-divider rounded-lg text-sm focus:border-brand-blue outline-none">
                            </div>
                        </div>

                        {# Sidebar (Right Side) #}
                        <div class="col-span-12 lg:col-span-3 lg:border-l lg:border-custom-divider lg:pl-5">
                            <p class="text-xs font-bold text-custom-text mb-2 uppercase tracking-wider">Private key</p>
                            <div role="group">
                                <label for="key-pair-algorithm" class="block text-[12px] font-medium text-custom-text mb-0.5">Key pair algorithm</label>
                                <select id="key-pair-algorithm" class="w-full px-3 py-1.5 border border-custom-divider rounded-lg text-sm focus:border-brand-blue outline-none bg-white">
                                    <option disabled="disabled" selected value=""> Select an option </option>
                                    <option value="EC">EC</option>
                                    <option value="RSA">RSA</option>
                                </select>
                                <div role="alert" class="invalid-feedback hidden text-red-500 text-[10px] mt-0.5">Field required</div>
                            </div>
                        </div>

                    </div>
                </form>
            </div>

            <div class="px-6 py-3 bg-custom-light-bg border-t border-custom-divider flex justify-end gap-3">
                <button class="modal-close px-5 py-1.5 text-sm font-medium bg-custom-text/20 text-custom-text rounded-full hover:bg-custom-text/30 transition-all">Cancel</button>
                <button form="generate-csr-form" type="submit" class="px-6 py-2 bg-brand-blue hover:bg-custom-hover-bg text-white text-sm font-medium rounded-full shadow-md transition-all active:scale-95">Generate CSR</button>
            </div>
        </div>
    </div>
{% endblock %}
{% block scripts %}
    <script src="/js/certificates.js" defer></script>
{% endblock %}