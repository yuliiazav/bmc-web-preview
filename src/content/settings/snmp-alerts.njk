---
permalink: /snmp-alerts/
---
{% extends "../../_includes/index.njk" %}

{% block content %}
    <div class="mx-auto">
        <h1 class="text-[32px] font-medium text-custom-text leading-[130%] tracking-normal mb-2">SNMP alerts</h1>
        <p class="text-base font-normal text-custom-aside-text leading-none mb-9">
            Set the Simple Network Management Protocol (SNMP) traps with an IP address and a port.
        </p>

        <div class="flex justify-end items-start mb-3">
            <button id="btn-add-snmp-destination" class="flex items-center gap-2 bg-brand-blue text-white px-4 py-2.5 rounded-[28px] hover:bg-custom-hover-bg transition-all active:scale-95 shadow-sm">
                <span class="flex items-center justify-center w-4 h-4 shrink-0 text-white">
                    {% include "src/assets/icons/icon-plus.svg" %}
                </span>
                <span class="text-sm font-medium leading-[1.2] tracking-normal">Add destination</span>
            </button>
        </div>

        <div class="bg-white border border-custom-divider overflow-hidden rounded-lg">
            <table class="w-full text-left border-collapse table-fixed">
                <thead class="bg-custom-light-bg border-b border-custom-divider sticky top-0 z-10">
                    <tr>
                        <td class="px-2 py-5 w-12 h-16 text-center">
                            <input type="checkbox" 
                                style="accent-color: var(--color-custom-accent);"
                                class="w-4 h-4 rounded border-custom-divider cursor-pointer transition-colors focus:ring-[var(--color-custom-accent)] focus:ring-offset-0">
                        </td>
                        <th class="px-4 py-5 w-[30%] h-16 text-md font-medium text-custom-text leading-none tracking-normal">
                            IP address
                        </th>
                        <th class="px-4 py-5 text-md font-medium text-custom-text leading-none tracking-normal">
                            Port
                        </th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-custom-divider">
                    <tr class="hover:bg-white transition-colors">
                        <td colspan="3" class="px-4 py-8 h-16 text-sm font-normal text-center text-custom-aside-text leading-[21px] break-words tracking-normal">
                            No items available
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    {# Modal for adding SNMP destination #}
    <div id="modal-add-snmp" class="fixed inset-0 z-[100] hidden flex items-center justify-center bg-black/50 backdrop-blur-sm px-4">
        <div class="bg-white rounded-[16px] shadow-2xl w-full max-w-[540px] overflow-hidden">
            <div class="px-6 py-4 border-b border-custom-divider flex justify-between items-center bg-custom-light-bg">
                <h3 class="text-lg font-bold text-custom-text">Add SNMP alert destination</h3>
                <button class="modal-close-snmp text-custom-aside-text hover:text-custom-text text-2xl leading-none">&times;</button>
            </div>

            <div class="p-8 grid grid-cols-2 gap-6">
                <div class="col-span-1">
                    <label for="snmp-ip-add-input" class="block text-xs font-medium text-custom-text mb-2">IP address</label>
                    <input type="text" id="snmp-ip-add-input" class="w-full px-4 py-3 border border-custom-divider rounded-lg text-sm focus:border-brand-blue outline-none transition-colors">
                    <div role="alert" class="invalid-feedback">
                        <!---->
                    </div>
                </div>
                <div class="col-span-1">
                    <label for="snmp-port-add-input" class="block text-xs font-medium text-custom-text mb-2">Port - optional</label>
                    <input type="text" id="snmp-port-add-input" class="w-full px-4 py-3 border border-custom-divider rounded-lg text-sm focus:border-brand-blue outline-none transition-colors">
                    <div role="alert" class="invalid-feedback">
                        <!---->
                    </div>
                </div>
            </div>

            <div class="px-6 py-4 bg-custom-light-bg border-t border-custom-divider flex justify-end gap-3">
                <button class="modal-close-snmp px-6 py-2 text-sm font-medium bg-custom-text/30 text-white rounded-full hover:bg-custom-text/50 transition-all active:scale-95">Cancel</button>
                <button id="btn-save-snmp" class="px-8 py-2.5 bg-brand-blue hover:bg-custom-hover-bg text-white text-sm font-medium rounded-full shadow-md transition-all active:scale-95">Add destination</button>
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script src="/js/snmp-alerts.js" defer></script>
{% endblock %}