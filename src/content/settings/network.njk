---
permalink: /network/
---
{% extends "../../_includes/index.njk" %}
{# The toggle switch is a macro defined in src/_includes/macros/toggle.njk #}
{% from "macros/toggle.njk" import toggle_switch %}

{% block content %}
    <div class="mx-auto">
        <h1 class="text-[32px] font-medium text-custom-text leading-[130%] tracking-normal mb-2">Network</h1>
        <p class="text-base font-normal text-custom-aside-text leading-none mb-14">
            Configure IPDesk network settings
        </p>

        <section class="mb-16">
            <h2 class="text-xl font-medium text-custom-text leading-[130%] mb-4">Network settings</h2>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-[152px] max-w-[1100px]">
                <div class="flex flex-col gap-1">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-medium leading-[1.5] text-custom-text">Hostname</span>
                        <span id="btn-edit-hostname" class="flex items-center text-brand-blue justify-center w-4 h-4 shrink-0 cursor-pointer">
                            {% include "src/assets/icons/icon-edit.svg" %}
                        </span>
                    </div>
                    <span id="val-hostname" class="text-sm font-normal leading-[1.5] text-custom-text">ast2600-default</span>
                </div>

                {% set switches = [
                    {
                        label: "Use domain name",
                        id: "domain",
                        checked: false
                    }, {
                        label: "Use DNS servers",
                        id: "dns",
                        checked: true
                    }, {
                        label: "Use NTP servers",
                        id: "ntp",
                        checked: true
                    }
                ] %}

                {% for switch in switches %}
                    <div class="flex flex-col gap-1">
                        <span class="text-sm font-medium leading-[1.5] text-custom-text">
                            {{ switch.label }}
                        </span>
                        {{ toggle_switch(
            id = "switch-" + switch.id, 
            label_text = "Enabled" if switch.checked else "Disabled", 
            checked = switch.checked 
        ) }}
                    </div>
                {% endfor %}
            </div>
        </section>

        <div class="border border-custom-divider overflow-hidden mb-12 rounded-lg">
            <div class="bg-custom-light-bg">
                <div class="flex p-2">
                    <button data-interface="bond0" class="text-sm leading-[1.5] font-medium text-custom-text border-b-[3px] border-brand-blue bg-custom-aside-bg w-[93px] py-3 hover:bg-white/50 transition-colors">
                        bond0
                    </button>
                    <button data-interface="eth0" class="w-[93px] py-3 text-sm font-normal text-custom-aside-text hover:bg-white/50 border-b border-custom-divider transition-colors">
                        eth0
                    </button>
                    <button data-interface="eth1" class="w-[93px] py-3 text-sm font-normal text-custom-aside-text hover:bg-white/50 border-b border-custom-divider transition-colors">
                        eth1
                    </button>
                </div>
            </div>

            <div class="px-6 py-9 bg-white">
                <div class="grid grid-cols-2 gap-[152px] mb-[72px] max-w-[400px]">
                    <div>
                        <p class="text-sm font-medium leading-[1.5] text-custom-text mb-1">Link status</p>
                        <p id="val-link-status" class="text-sm font-normal leading-[1.5] text-custom-text">NoLink</p>
                    </div>
                    <div>
                        <p class="text-sm font-medium leading-[1.5] text-custom-text mb-1">Speed (mbps)</p>
                        <p id="val-speed" class="text-sm font-normal leading-[1.5] text-custom-text">65535</p>
                    </div>
                </div>

                <div class="mb-9">
                    <h3 class="text-xl font-medium text-custom-text leading-[130%] mb-4">Interface settings</h3>
                    <div class="grid grid-cols-2 gap-[152px] max-w-[400px]">
                        <div>
                            <p class="text-sm font-medium leading-[1.5] text-custom-text mb-1">FQDN</p>
                            <p id="val-fqdn" class="text-sm font-normal leading-[1.5] text-custom-text">ast2600-default</p>
                        </div>
                        <div>
                            <div class="flex items-center gap-2 mb-1">
                                <span class="text-sm font-medium leading-[1.5] text-custom-text">MAC address</span>
                                <span id="btn-edit-mac" class="flex items-center text-brand-blue justify-center w-4 h-4 shrink-0 cursor-pointer">
                                    {% include "src/assets/icons/icon-edit.svg" %}
                                </span>
                            </div>
                            <p id="val-mac" class="text-sm font-normal leading-[1.5] text-custom-text">72:47:7e:cc:7f:d6</p>
                        </div>
                    </div>
                </div>

                <hr class="border-custom-divider mb-9"/>

                <div class="mb-14">
                    <h3 class="text-xl font-medium text-custom-text leading-[130%] mb-4">Interface settings</h3>
                    <div class="flex flex-col gap-1">
                        <span class="text-sm font-medium leading-[1.5] text-custom-text">DHCP</span>
                        {{ toggle_switch(
                            id = "switch-dhcp", 
                            label_text = "Enabled", 
                            checked = true
                        ) }}
                    </div>
                </div>

                <div class="mb-14">
                    <div class="flex justify-between items-center mb-2">
                        <h4 class="text-sm font-medium leading-[1.5] text-custom-text">IPv4 addresses</h4>
                        <button id="btn-add-ipv4-address-ip" class="flex items-center gap-2 px-4 py-2.5 bg-brand-blue hover:bg-custom-hover-bg text-white text-sm leading-[120%] font-medium rounded-[28px] transition-all active:scale-95">
                            <span class="flex items-center text-white justify-center w-4 h-4 shrink-0 ">
                                {% include "src/assets/icons/icon-plus.svg" %}
                            </span>
                            Add static IPv4 address
                        </button>
                    </div>
                    <div class="border border-custom-divider rounded-lg overflow-hidden">
                        <table class="w-full text-left text-sm">
                            <thead class="bg-custom-light-bg text-custom-text leading-none font-medium">
                                <tr>
                                    <th class="px-6 py-5">IP address</th>
                                    <th class="px-6 py-5">Gateway</th>
                                    <th class="px-6 py-5">Subnet mask</th>
                                    <th class="px-6 py-5">Address origin</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-custom-divider leading-[130%] text-custom-text">
                                <tr>
                                    <td class="px-6 py-4">192.168.1.105</td>
                                    <td class="px-6 py-4">192.168.1.1</td>
                                    <td class="px-6 py-4">255.255.255.0</td>
                                    <td class="px-6 py-4">Static</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="max-w-[600px]">
                    <div class="flex justify-between items-center mb-4">
                        <h4 class="text-xl font-medium text-custom-text leading-[130%]">Static DNS</h4>
                        <button id="btn-add-dns-ip-address" class="flex items-center gap-2 px-4 py-2.5 bg-brand-blue hover:bg-custom-hover-bg text-white text-sm leading-[120%] font-medium rounded-[28px] transition-all active:scale-95">
                            <span class="flex items-center text-white justify-center w-4 h-4 shrink-0">
                                {% include "src/assets/icons/icon-plus.svg" %}
                            </span>
                            Add IP address
                        </button>
                    </div>
                    <div class="border border-custom-divider rounded-lg overflow-hidden">
                        <div class="bg-custom-light-bg px-6 py-5 text-sm leading-none font-medium text-custom-text border-b border-custom-divider">IP address</div>
                        <div class="px-6 py-4 text-sm leading-[130%] border-b border-custom-divider text-custom-text">1.1.1.1</div>
                        <div class="px-6 py-4 text-sm leading-[130%] text-custom-text">8.8.8.8</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {# formattin, adding ip addressesmodals, updates msg #}
    {#modal for editing hostname #}
    <div id="modal-edit-field" class="fixed inset-0 z-[100] hidden flex items-center justify-center bg-black/50 backdrop-blur-sm px-4">
        <div class="bg-white rounded-[16px] shadow-2xl w-full max-w-[440px] overflow-hidden transition-all">
            <div class="px-6 py-4 border-b border-custom-divider flex justify-between items-center bg-custom-light-bg">
                <h3 id="edit-modal-title" class="text-lg font-bold text-custom-text">Edit hostname</h3>
                <button class="modal-close text-custom-aside-text hover:text-custom-text text-2xl leading-none">&times;</button>
            </div>
            <div class="p-8">
                <label id="edit-modal-label" for="edit-modal-input" class="block text-xs font-medium text-custom-text mb-2">Hostname</label>
                <input type="text" id="edit-modal-input" class="w-full px-4 py-3 border border-custom-divider rounded-lg focus:outline-none focus:border-brand-blue text-sm">
                <div role="alert" class="invalid-feedback"></div>
            </div>
            <div class="px-6 py-4 bg-custom-light-bg border-t border-custom-divider flex justify-end gap-3">
                <button class="modal-close px-6 py-2 text-sm font-medium bg-custom-text/30 text-white rounded-full hover:bg-custom-text/50 transition-all active:scale-95">Cancel</button>
                <button id="btn-save-field" class="px-8 py-2.5 bg-brand-blue hover:bg-custom-hover-bg text-white text-sm font-medium rounded-full shadow-md transition-all">Add</button>
            </div>
        </div>
    </div>
    {# Modal for disable DHCP #}
    <div id="modal-disable-dhcp" class="fixed inset-0 z-[100] hidden flex items-center justify-center bg-black/50 backdrop-blur-sm px-4">
        <div class="bg-white rounded-[16px] shadow-2xl w-full max-w-[440px] overflow-hidden transition-all">
            <div class="px-6 py-4 border-b border-custom-divider flex justify-between items-center bg-custom-light-bg">
                <h3 class="text-lg font-bold text-custom-text">Disable DHCP</h3>
                <button class="modal-close text-custom-aside-text hover:text-custom-text text-2xl leading-none">&times;</button>
            </div>
            <div class="p-8">
                <p class="text-sm text-custom-text">Are you sure you want to disable DHCP?</p>
            </div>
            <div class="px-6 py-4 bg-custom-light-bg border-t border-custom-divider flex justify-end gap-3">
                <button class="modal-close px-6 py-2 text-sm font-medium bg-custom-text/30 text-white rounded-full hover:bg-custom-text/50 transition-all active:scale-95">Cancel</button>
                <button id="btn-confirm-disable-dhcp" class="px-8 py-2.5 bg-[#D62F2F] hover:bg-red-700 text-white text-sm font-medium rounded-full shadow-md transition-all">Disable</button>
            </div>
        </div>
    </div>
    {# Modal for adding static IPv4 address #}
    <div id="modal-dns-address-ip" class="fixed inset-0 z-[100] hidden flex items-center justify-center bg-black/50 backdrop-blur-sm px-4">
        <div class="bg-white rounded-[16px] shadow-2xl w-full max-w-[540px] overflow-hidden transition-all">
            <div class="px-6 py-4 border-b border-custom-divider flex justify-between items-center bg-custom-light-bg">
                <h3 class="text-lg font-bold text-custom-text">Add IP address</h3>
                <button class="modal-close text-custom-aside-text hover:text-custom-text text-2xl leading-none">&times;</button>
            </div>
            <div class="p-8 grid grid-cols-2 gap-6">
                <div class="col-span-1">
                    <label for="static-dns-add-input" class="block text-xs font-medium text-custom-text mb-2">Static DNS</label>
                    <input type="text" id="static-dns-add-input" class="w-full px-4 py-3 border border-custom-divider rounded-lg text-sm focus:border-brand-blue outline-none">
                    <div role="alert" class="invalid-feedback">
                        <!---->
                    </div>
                </div>
            </div>
            <div class="px-6 py-4 bg-custom-light-bg border-t border-custom-divider flex justify-end gap-3">
                <button class="modal-close px-6 py-2 text-sm font-medium bg-custom-text/30 text-white rounded-full hover:bg-custom-text/50 transition-all active:scale-95">Cancel</button>
                <button class="px-8 py-2.5 bg-brand-blue hover:bg-custom-hover-bg text-white text-sm font-medium rounded-full shadow-md transition-all">Add</button>
            </div>
        </div>
    </div>
    {# Modal for adding static IPv4 address #}
    <div id="modal-ipv4-address-ip" class="fixed inset-0 z-[100] hidden flex items-center justify-center bg-black/50 backdrop-blur-sm px-4">
        <div class="bg-white rounded-[16px] shadow-2xl w-full max-w-[540px] overflow-hidden transition-all">
            <div class="px-6 py-4 border-b border-custom-divider flex justify-between items-center bg-custom-light-bg">
                <h3 class="text-lg font-bold text-custom-text">Add static IPv4 address</h3>
                <button class="modal-close text-custom-aside-text hover:text-custom-text text-2xl leading-none">&times;</button>
            </div>
            <div class="p-8 grid grid-cols-2 gap-6">
                <div class="col-span-1">
                    <label for="ipv4-address-add-input" class="block text-xs font-medium text-custom-text mb-2">IP address</label>
                    <input type="text" id="ipv4-address-add-input" class="w-full px-4 py-3 border border-custom-divider rounded-lg text-sm focus:border-brand-blue outline-none">
                    <div role="alert" class="invalid-feedback">
                        <!---->
                    </div>
                </div>
                <div class="col-span-1">
                    <label for="gateway-add-input" class="block text-xs font-medium text-custom-text mb-2">Gateway</label>
                    <input type="text" id="gateway-add-input" class="w-full px-4 py-3 border border-custom-divider rounded-lg text-sm focus:border-brand-blue outline-none">
                    <div role="alert" class="invalid-feedback">
                        <!---->
                    </div>

                </div>
                <div class="col-span-2">
                    <label for="subnet-mask-add-input" class="block text-xs font-medium text-custom-text mb-2">Subnet mask</label>
                    <input type="text" id="subnet-mask-add-input" class="w-full px-4 py-3 border border-custom-divider rounded-lg text-sm focus:border-brand-blue outline-none">
                    <div role="alert" class="invalid-feedback">
                        <!---->
                    </div>
                </div>
            </div>
            <div class="px-6 py-4 bg-custom-light-bg border-t border-custom-divider flex justify-end gap-3">
                <button class="modal-close px-6 py-2 text-sm font-medium bg-custom-text/30 text-white rounded-full hover:bg-custom-text/50 transition-all active:scale-95">Cancel</button>
                <button class="px-8 py-2.5 bg-brand-blue hover:bg-custom-hover-bg text-white text-sm font-medium rounded-full shadow-md transition-all">Add</button>
            </div>
        </div>
    </div>

{% endblock %}
{% block scripts %}
    <script src="/js/network.js" defer></script>
{% endblock %}