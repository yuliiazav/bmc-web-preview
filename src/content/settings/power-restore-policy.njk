---
permalink: /power-restore-policy/
---
{% extends "../../_includes/index.njk" %}
{% block content %}
    <div class="mx-auto">
        <h1 class="text-[32px] font-medium text-custom-text leading-[130%] tracking-normal mb-2">Power restore policy</h1>
        <p class="text-base font-normal text-custom-aside-text leading-none mb-9">
            Configure power policy to determine how the system starts after a power disturbance.
        </p>

        <div class="flex flex-col gap-4 mb-10">
            <span class="text-sm leading-[125%] font-normal text-custom-aside-text mb-2">Power restore policies</span>

            <label class="flex items-start gap-4 cursor-pointer group">
                <div class="relative flex items-center justify-center">
                    <input type="radio" name="power-restore-option" class="peer sr-only" checked="checked"/>
                    <div class="w-5 h-5 border border-custom-border rounded-full peer-checked:border-brand-blue transition-all"></div>
                    <div class="absolute w-2.5 h-2.5 bg-brand-blue rounded-full opacity-0 peer-checked:opacity-100 transition-opacity"></div>
                </div>
                <div class="flex flex-col gap-3">
                    <span class="text-base font-normal text-custom-text leading-none">Always on - The system always powers on when power is applied.</span>
                </div>
            </label>

            <label class="flex items-start gap-4 cursor-pointer group">
                <div class="relative flex items-center justify-center">
                    <input type="radio" name="power-restore-option" class="peer sr-only"/>
                    <div class="w-5 h-5 border border-custom-border rounded-full peer-checked:border-brand-blue transition-all"></div>
                    <div class="absolute w-2.5 h-2.5 bg-brand-blue rounded-full opacity-0 peer-checked:opacity-100 transition-opacity"></div>
                </div>
                <div class="flex flex-col gap-3">
                    <span class="text-base font-normal text-custom-text leading-none">Always off - The system always remains powered off when power is applied.</span>
                </div>
            </label>
            <label class="flex items-start gap-4 cursor-pointer group">
                <div class="relative flex items-center justify-center">
                    <input type="radio" name="power-restore-option" class="peer sr-only"/>
                    <div class="w-5 h-5 border border-custom-border rounded-full peer-checked:border-brand-blue transition-all"></div>
                    <div class="absolute w-2.5 h-2.5 bg-brand-blue rounded-full opacity-0 peer-checked:opacity-100 transition-opacity"></div>
                </div>
                <div class="flex flex-col gap-3">
                    <span class="text-base font-normal text-custom-text leading-none">Last state - The system returns to its last on or off power state when power is applied.</span>
                </div>
            </label>
        </div>

        <button
            type="button"
            class="px-[69px] py-3 bg-brand-blue hover:bg-custom-hover-bg text-white text-sm leading-[120%] font-medium rounded-[28px] transition-colors shadow-sm">
            Save settings
        </button>
    </div>
{% endblock %}