---
permalink: /kvm/
---
{% extends "../../_includes/index.njk" %}
{% block content %}
    <div class="mx-auto">
        <h1 class="text-[32px] font-medium text-[#1D1D1F] leading-[130%] tracking-normal mb-2">KVM</h1>
        <p class="text-base font-normal text-[#4D4D4D] leading-none mb-9">
            Remote video console for SmartAVI server access.
        </p>
        <div class="bg-white rounded-[16px] px-6 py-4 flex justify-between items-center shadow-[0_2px_6px_0_rgba(41,41,41,0.08)] mb-4">
            <div class="flex items-center gap-3">
                <span class="w-2 h-2 bg-[#23C45F] rounded-full shadow-[0_0_5px_0_#23C45FB2]"></span>
                <span class="text-sm font-medium text-black leading-none">Connected</span>
            </div>
            <div class="flex gap-3">
                <button
                    type="button"
                    class="flex items-center gap-1 px-5 py-3 bg-[#688CBA] hover:bg-[#5a7aa3] text-white text-sm font-normal leading-none
                        rounded-full transition-colors">
                    <span class="material-symbols-outlined text-[14px]">open_in_new</span>
                    Open in new tab
                </button>
                <button
                    type="button"
                    class="px-5 py-3 bg-[#F0F3F8] hover:bg-[#E0E7F0] text-[#688CBA] text-sm font-normal leading-none rounded-full
                        transition-colors">
                    Send Ctrl+Alt+Del
                </button>
            </div>
        </div>
        <div class="relative w-full aspect-[5/2] bg-black rounded-lg overflow-hidden flex items-center justify-center">
            <div class="text-[#63748A] text-sm leading-none font-normal">
                Live feed preview (KVM stream)
            </div>
        </div>
    </div>
{% endblock %}