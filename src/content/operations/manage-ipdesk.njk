---
permalink: /manage-ipdesk/
---
{% extends "../../_includes/index.njk" %}
{% block content %}
    <div class="mx-auto">
        <h1 class="text-[32px] font-medium text-custom-text leading-[130%] tracking-normal mb-4">Manage IPDesk</h1>

        <div class="mb-7">
            <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">Last IPDesk reboot</p>
            <p id="ipdesk-last-reboot-time" class="text-sm font-normal text-custom-aside-text leading-[1.5]">2025-10-17 15:00:39 UTC</p>
        </div>

        <p class="text-sm font-normal text-custom-aside-text leading-[1.5] mb-10 max-w-[620px]">
            When you reboot the IPDesk, your web browser loses contact with the IPDesk for several minutes. When the IPDesk is back online, you may need to log in again.
        </p>

        <div class="flex flex-wrap gap-4 mb-10">
            <button type="button" 
            id="btn-reboot-ipdesk"
                class="px-10 py-3 bg-brand-blue hover:bg-custom-hover-bg text-white text-sm font-medium rounded-full transition-all shadow-sm active:scale-95">
                Reboot IPDesk
            </button>

            <button type="button" 
            id="btn-remote-pc-off"
                class="px-6 py-3 bg-custom-light-bg hover:bg-custom-divider text-brand-blue text-sm font-medium rounded-full transition-all active:scale-95">
                Remote PC power OFF
            </button>

            <button type="button" 
            id="btn-remote-pc-on"
                class="px-6 py-3 bg-custom-light-bg hover:bg-custom-divider text-brand-blue text-sm font-medium rounded-full transition-all active:scale-95">
                Remote PC power ON
            </button>
        </div>

        <div id="pc-state-indicator" class="mb-12 p-4 bg-custom-light-bg/50 rounded-xl inline-block border border-custom-divider/30">
            <p class="text-xs font-semibold text-custom-aside-text uppercase tracking-wider mb-1">Current State Remote PC</p>
            <p id="pc-current-state-val" class="text-lg font-bold text-custom-text">Off</p>
        </div>
        {#  GPIO  #}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-[1000px]">
            {% for i in range(0, 4) %}
                <div id="card-gpio-{{ i }}" class="bg-white rounded-[20px] p-6 flex flex-col items-center border border-custom-divider shadow-sm hover:shadow-md transition-shadow">
                    <span class="text-[10px] font-bold text-custom-aside-text uppercase tracking-widest mb-6">GPIO Port {{ i }}</span>

                    <div class="flex flex-col gap-3 w-full">
                        <button 
                            id="btn-gpio-high-{{ i }}"
                            data-port="{{ i }}"
                            data-action="high"
                            class="w-full py-3 bg-[#23C45F] hover:bg-[#1eb054] text-white text-[12px] font-bold rounded-xl transition-all active:opacity-80">
                            High {{ i }}
                        </button>

                        <button 
                            id="btn-gpio-low-{{ i }}"
                            data-port="{{ i }}"
                            data-action="low"
                            class="w-full py-3 bg-[#EF4345] hover:bg-[#d93a3c] text-white text-[12px] font-bold rounded-xl transition-all active:opacity-80">
                            Low {{ i }}
                        </button>

                        <button 
                            id="btn-gpio-ask-{{ i }}"
                            data-port="{{ i }}"
                            data-action="ask"
                            class="w-full py-3 bg-custom-light-bg hover:bg-custom-divider text-brand-blue text-[12px] font-bold rounded-xl transition-all active:opacity-80">
                            Ask {{ i }}
                        </button>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    {# Modal window for reboot IPDesk btn #}
    <div id="modal-confirm-action" class="fixed inset-0 z-[100] hidden flex items-center justify-center bg-black/50 backdrop-blur-sm px-4">
        <div class="bg-white rounded-[16px] shadow-2xl w-full max-w-[440px] overflow-hidden transform transition-all">
            <div class="px-6 py-4 border-b border-custom-divider flex justify-between items-center bg-custom-light-bg">
                <h3 id="modal-title" class="text-lg font-bold text-custom-text">Confirm Action</h3>
                <button id="modal-close-x" class="text-custom-aside-text hover:text-custom-text transition-colors text-2xl leading-none">&times;</button>
            </div>

            <div class="p-8">
                <p id="modal-description" class="text-base text-center text-pretty font-normal text-custom-text leading-relaxed">
                Are you sure you want to proceed?
            </p>
            </div>

            <div class="px-6 py-4 bg-custom-light-bg border-t border-custom-divider flex justify-end gap-3">
                <button id="modal-btn-cancel" 
            class="px-6 py-2 text-sm font-medium bg-custom-text/30 text-white rounded-full hover:bg-custom-text/50 transition-all active:scale-95">
        Cancel
    </button>

                <button id="modal-btn-confirm" 
            class="px-6 py-2 text-sm font-medium bg-brand-blue text-white rounded-full hover:bg-custom-hover-bg shadow-md transition-all active:scale-95">
        Confirm
    </button>
            </div>
        </div>
    </div>
{% endblock %}
{% block scripts %}
    <script src="/js/manage-ipdesk.js" defer></script>
{% endblock %}