---
permalink: /manage-bmc/
---
{% extends "../../_includes/index.njk" %}
{% block content %}
    <div class="mx-auto">
        <h1 class="text-[32px] font-medium text-custom-text leading-[130%] tracking-normal mb-4">Manage BMC</h1>

        <div class="mb-7">
            <p class="text-sm font-medium text-custom-text leading-[1.5] mb-1">Last BMC reboot</p>
            <p class="text-sm font-normal text-custom-aside-text leading-[1.5]">2025-10-17 15:00:39 UTC</p>
        </div>

        <p class="text-sm font-normal text-custom-aside-text leading-[1.5] mb-10 max-w-[620px]">
            When you reboot the BMC, your web browser loses contact with the BMC for several minutes. When the BMC is back online, you may need to log in again.
        </p>

        <div class="flex flex-wrap gap-4 mb-10">
            <button type="button" 
                class="px-10 py-3 bg-brand-blue hover:bg-custom-hover-bg text-white text-sm font-medium rounded-full transition-all shadow-sm active:scale-95">
                Reboot BMC
            </button>

            <button type="button" 
                class="px-6 py-3 bg-custom-light-bg hover:bg-custom-divider text-brand-blue text-sm font-medium rounded-full transition-all active:scale-95">
                Remote PC power OFF
            </button>

            <button type="button" 
                class="px-6 py-3 bg-custom-light-bg hover:bg-custom-divider text-brand-blue text-sm font-medium rounded-full transition-all active:scale-95">
                Remote PC power ON
            </button>
        </div>

        <div class="mb-12 p-4 bg-custom-light-bg/50 rounded-xl inline-block border border-custom-divider/30">
            <p class="text-xs font-semibold text-custom-aside-text uppercase tracking-wider mb-1">Current State Remote PC</p>
            <p class="text-lg font-bold text-custom-text">Off</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-[1000px]">
            {% for i in range(0, 4) %}
                <div class="bg-white rounded-[20px] p-6 flex flex-col items-center border border-custom-divider shadow-sm hover:shadow-md transition-shadow">
                    <span class="text-xs font-bold text-custom-aside-text uppercase tracking-widest mb-6">GPIO Port {{ i }}</span>

                    <div class="flex flex-col gap-3 w-full">
                        <button class="w-full py-3 bg-[#23C45F] hover:bg-[#1eb054] text-white text-sm font-bold rounded-xl transition-all active:opacity-80">
                            High {{ i }}
                        </button>

                        <button class="w-full py-3 bg-[#EF4345] hover:bg-[#d93a3c] text-white text-sm font-bold rounded-xl transition-all active:opacity-80">
                            Low {{ i }}
                        </button>

                        <button class="w-full py-3 bg-custom-light-bg hover:bg-custom-divider text-brand-blue text-sm font-bold rounded-xl transition-all active:opacity-80">
                            Ask {{ i }}
                        </button>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}