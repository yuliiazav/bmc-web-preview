---
permalink: /virtual-media/
---
{% extends "../../_includes/index.njk" %}
{% block content %}
    <div class="mx-auto">
        <h1 class="text-[32px] font-medium text-[#1D1D1F] leading-[130%] tracking-normal mb-6">Virtual media</h1>
        <section>
            <h2 class="text-xl font-medium text-[#1D1D1F] leading-[130%] mb-5">Load image from web browser</h2>
            <div class="flex flex-col items-start gap-2 mb-10">
                <span class="text-sm leading-[1.5] font-normal text-[#151515] mb-2">Virtual media device</span>
                <button
                    type="button"
                    class="flex items-center gap-2 px-10 py-3 bg-[#688CBA] hover:bg-[#5a7aa3] text-white text-sm leading-[120%] font-medium
                        rounded-[28px] transition-colors">
                    <span class="material-symbols-outlined text-[16px]">add</span>
                    Add File
                </button>
            </div>
            <button
                type="button"
                class="px-11 py-3 bg-[#EBEBEB99] hover:bg-[#D4D4D4] text-[#A3A3A3] text-sm leading-[120%] font-normal rounded-[28px]
                    transition-colors">
                Start
            </button>
        </section>
    </div>
{% endblock %}