---
permalink: /virtual-media/
---
{% extends "../../_includes/index.njk" %}
{% block content %}
    <div class="mx-auto">
        <h1 class="text-[32px] font-medium text-custom-text leading-[130%] tracking-normal mb-6">Virtual media</h1>
        <section>
            <h2 class="text-xl font-medium text-custom-text leading-[130%] mb-5">Load image from web browser</h2>
            <div class="flex flex-col items-start gap-2 mb-10">
                <span class="text-sm leading-[1.5] font-normal text-custom-text mb-2">Virtual media device</span>
                <button
                    type="button"
                    class="flex items-center gap-2 px-10 py-3 bg-brand-blue hover:bg-custom-hover-bg text-white text-sm leading-[120%] font-medium
                        rounded-[28px] transition-colors">
                    <span class="flex items-center justify-center w-4 h-4 shrink-0">
                        {% include "src/assets/icons/icon-plus.svg" %}
                    </span>                    Add File
                </button>
            </div>

            <button
                type="button"
                class="px-11 py-3 bg-custom-light-bg hover:bg-custom-divider text-custom-aside-text hover:text-custom-text text-sm leading-[120%] font-normal rounded-[28px]
                    transition-colors">
                Start
            </button>
        </section>
    </div>
{% endblock %}