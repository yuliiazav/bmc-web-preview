---
permalink: /event-logs/
---
{% extends "../../_includes/index.njk" %}
{% block content %}
    <div class="mx-auto">
        <div class="flex justify-between items-start mb-12">
            <h1 class="text-[32px] font-medium text-[#1D1D1F] leading-[130%] tracking-normal mb-2">Event logs</h1>
            <div class="flex gap-6">
                <div class="flex flex-col gap-2">
                    <span class="text-xs font-normal text-[#151515] leading-[1.5]">From date</span>
                    <div class="relative">
                        <input
                            type="text"
                            placeholder="YYYY-MM-DD"
                            class="w-[200px] border border-[#EBEBED] rounded-full px-[42px] py-3 text-xs leading-none font-normal text-[#151515]
                                placeholder-[#707070] focus:outline-none focus:border-[#688CBA] transition-colors"/>
                        <span class="material-symbols-outlined absolute left-5 top-1/2 -translate-y-1/2 text-[#707070] text-[14px]">
                            calendar_today</span>
                    </div>
                </div>
                <div class="flex flex-col gap-2">
                    <span class="text-xs font-normal text-[#151515] leading-[1.5]">To date</span>
                    <div class="relative">
                        <input
                            type="text"
                            placeholder="YYYY-MM-DD"
                            class="w-[200px] border border-[#EBEBED] rounded-full px-[42px] py-3 text-xs leading-none font-normal text-[#151515]
                                placeholder-[#707070] focus:outline-none focus:border-[#688CBA] transition-colors"/>
                        <span class="material-symbols-outlined absolute left-5 top-1/2 -translate-y-1/2 text-[#707070] text-[14px]">
                            calendar_today</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="relative mb-3 max-w-[200px]">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#707070] text-[16px]">search</span>
            <input
                type="text"
                placeholder="Search logs"
                class="w-[200px] border border-[#EBEBED] rounded-full pl-10 py-3 text-xs leading-none font-normal text-[#151515]
                    placeholder-[#707070] focus:outline-none focus:border-[#688CBA] transition-colors"/>
        </div>
        <div class="bg-white border border-[#E0E0E0] overflow-hidden">
            <table class="w-full text-left border-collapse">
                <thead class="bg-[#F0F4F9] border-b border-[#E0E0E0]">
                    <tr>
                        <th class="px-4 py-5 w-10"></th>
                        <th class="px-2 py-5 w-8">
                            <input type="checkbox" class="w-4 h-4 rounded border-[#C7C7C7]"/>
                        </th>
                        <th class="px-4 py-5 text-sm font-medium text-[#151515] leading-none tracking-normal">ID</th>
                        <th class="px-4 py-5 text-sm font-medium text-[#151515] leading-none tracking-normal">Severity</th>
                        <th class="px-4 py-5 text-sm font-medium text-[#151515] leading-none tracking-normal">Date</th>
                        <th class="px-4 py-5 text-sm font-medium text-[#151515] leading-none tracking-normal">Description</th>
                        <th class="px-4 py-5 w-[180px] text-sm font-medium text-[#151515] leading-none tracking-normal">Status</th>
                        <th class="px-5 py-5 w-[108px]"></th>
                    </tr>
                </thead>
                <tbody
                    class="divide-y divide-[#E0E0E0]">
                    {# EX: Warning #}
                    <tr class="hover:bg-[#FFFFFF] transition-colors">
                        <td class="px-4 py-4 text-center align-middle">
                            <span class="material-symbols-outlined text-[#707070] text-[24px] cursor-pointer">keyboard_arrow_down</span>
                        </td>
                        <td class="px-2 py-4">
                            <input type="checkbox" class="w-4 h-4 rounded border-[#C7C7C7]"/>
                        </td>
                        <td class="px-4 py-4">
                            <a
                                href="#"
                                class="text-sm font-normal text-[#6090C2] underline decoration-1 underline-offset-[2px] tracking-normal leading-[21px]">
                                1760121543
                            </a>
                        </td>
                        <td class="px-4 py-4">
                            <div class="inline-flex items-center gap-1 px-2 py-1 rounded-full border border-[#DCA614] text-[#DCA614]">
                                <span class="material-symbols-outlined text-[16px]">warning</span>
                                <span class="text-xs font-normal uppercase leading-[1.1] tracking-normal">Warning</span>
                            </div>
                        </td>
                        <td class="px-4 py-4 text-sm font-normal text-[#151515] leading-[1.3] tracking-normal">
                            2025-10-10<br/>18:39:03 UTC
                        </td>
                        <td class="px-4 py-4 text-sm font-normal text-[#151515] leading-[21px] max-w-[300px] break-words tracking-normal">
                            Service systemd-networkd-networkd-wait-online.service has exited unsuccessfully.
                        </td>
                        <td class="px-4 py-4">
                            <div class="flex items-center gap-2">
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" class="sr-only peer"/>
                                    <div class="w-[40px] h-[24px] bg-white border border-[#C7C7C7] rounded-full peer peer-focus:outline-none
                                        peer-checked:bg-[#688CBA] peer-checked:border-[#688CBA] transition-all /* Circle (14x14) */ after:content-['']
                                        after:absolute after:top-[5px] after:left-[4px] after:w-[14px] after:h-[14px] after:bg-[#707070] after:rounded-full
                                        after:transition-all /* Click state */ peer-checked:after:bg-white peer-checked:after:translate-x-[18px] /* Checkmark */
                                        before:content-['check'] before:font-['Material_Symbols_Outlined'] before:absolute before:left-[6px] before:top-[6px]
                                        before:text-white before:text-[12px] before:leading-none before:opacity-0 peer-checked:before:opacity-100
                                        before:transition-opacity"></div>
                                </label>
                                <span class="text-sm font-normal text-[#151515] leading-[21px] tracking-normal">Unresolved</span>
                            </div>
                        </td>
                        <td class="px-5 py-4">
                            <div class="flex gap-7 justify-end">
                                <span class="material-symbols-outlined text-[#707070] cursor-pointer hover:text-[#151515]">description</span>
                                <span class="material-symbols-outlined text-[#707070] cursor-pointer hover:text-red-500">delete</span>
                            </div>
                        </td>
                    </tr>
                    {# EX: Critical #}
                    <tr class="hover:bg-[#FFFFFF] transition-colors">
                        <td class="px-4 py-4 text-center align-middle">
                            <span class="material-symbols-outlined text-[#707070] text-[24px] cursor-pointer">keyboard_arrow_down</span>
                        </td>
                        <td class="px-2 py-4">
                            <input type="checkbox" class="w-4 h-4 rounded border-[#C7C7C7]"/>
                        </td>
                        <td class="px-4 py-4">
                            <a
                                href="#"
                                class="text-sm font-normal text-[#6090C2] underline decoration-1 underline-offset-[2px] tracking-normal leading-[21px]">
                                17601256756
                            </a>
                        </td>
                        <td class="px-4 py-4">
                            <div class="inline-flex items-center gap-1 px-2 py-1 rounded-full border border-[#B1380B] text-[#B1380B]">
                                <span class="material-symbols-outlined text-[16px]">cancel</span>
                                <span class="text-xs font-normal uppercase leading-[1.1] tracking-normal">Critical</span>
                            </div>
                        </td>
                        <td class="px-4 py-4 text-sm font-normal text-[#151515] leading-[1.3] tracking-normal">
                            2025-10-10<br/>18:39:03 UTC
                        </td>
                        <td class="px-4 py-4 text-sm font-normal text-[#151515] leading-[21px] max-w-[300px] break-words tracking-normal">
                            Service systemd-networkd-networkd-wait-online.service has exited unsuccessfully.
                        </td>
                        <td class="px-4 py-4">
                            <div class="flex items-center gap-2">
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" class="sr-only peer"/>
                                    <div class="w-[40px] h-[24px] bg-white border border-[#C7C7C7] rounded-full peer peer-focus:outline-none
                                        peer-checked:bg-[#688CBA] peer-checked:border-[#688CBA] transition-all /* Circle (14x14) */ after:content-['']
                                        after:absolute after:top-[5px] after:left-[4px] after:w-[14px] after:h-[14px] after:bg-[#707070] after:rounded-full
                                        after:transition-all /* Click state */ peer-checked:after:bg-white peer-checked:after:translate-x-[18px] /* Checkmark */
                                        before:content-['check'] before:font-['Material_Symbols_Outlined'] before:absolute before:left-[6px] before:top-[6px]
                                        before:text-white before:text-[12px] before:leading-none before:opacity-0 peer-checked:before:opacity-100
                                        before:transition-opacity"></div>
                                </label>
                                <span class="text-sm font-normal text-[#151515] leading-[21px] tracking-normal">Unresolved</span>
                            </div>
                        </td>
                        <td class="px-5 py-4 text-right">
                            <div class="flex gap-7 justify-end text-right">
                                <span class="material-symbols-outlined text-[#707070] cursor-pointer hover:text-[#151515]">description</span>
                                <span class="material-symbols-outlined text-[#707070] cursor-pointer hover:text-red-500">delete</span>
                            </div>
                        </td>
                    </tr>
                    {# EX: Ok #}
                    <tr class="hover:bg-[#FFFFFF] transition-colors">
                        <td class="px-4 py-4 text-center align-middle">
                            <span class="material-symbols-outlined text-[#707070] text-[24px] cursor-pointer">keyboard_arrow_down</span>
                        </td>
                        <td class="px-2 py-4">
                            <input type="checkbox" class="w-4 h-4 rounded border-[#C7C7C7]"/>
                        </td>
                        <td class="px-4 py-4">
                            <a
                                href="#"
                                class="text-sm font-normal text-[#6090C2] underline decoration-1 underline-offset-[2px] tracking-normal leading-[21px]">
                                17601256756
                            </a>
                        </td>
                        <td class="px-4 py-4">
                            <div class="inline-flex items-center gap-1 px-2 py-1 rounded-full border border-[#3D7317] text-[#3D7317]">
                                <span class="material-symbols-outlined text-[16px]">check_circle</span>
                                <span class="text-xs font-normal uppercase leading-[1.1] tracking-normal">Ok</span>
                            </div>
                        </td>
                        <td class="px-4 py-4 text-sm font-normal text-[#151515] leading-[1.3] tracking-normal">
                            2025-10-10<br/>18:39:03 UTC
                        </td>
                        <td class="px-4 py-4 text-sm font-normal text-[#151515] leading-[21px] max-w-[300px] break-words tracking-normal">
                            Service systemd-networkd-networkd-wait-online.service has exited unsuccessfully.
                        </td>
                        <td class="px-4 py-4">
                            <div class="flex items-center gap-2">
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" class="sr-only peer"/>
                                    <div class="w-[40px] h-[24px] bg-white border border-[#C7C7C7] rounded-full peer peer-focus:outline-none
                                        peer-checked:bg-[#688CBA] peer-checked:border-[#688CBA] transition-all /* Circle (14x14) */ after:content-['']
                                        after:absolute after:top-[5px] after:left-[4px] after:w-[14px] after:h-[14px] after:bg-[#707070] after:rounded-full
                                        after:transition-all /* Click state */ peer-checked:after:bg-white peer-checked:after:translate-x-[18px] /* Checkmark */
                                        before:content-['check'] before:font-['Material_Symbols_Outlined'] before:absolute before:left-[6px] before:top-[6px]
                                        before:text-white before:text-[12px] before:leading-none before:opacity-0 peer-checked:before:opacity-100
                                        before:transition-opacity"></div>
                                </label>
                                <span class="text-sm font-normal text-[#151515] leading-[21px] tracking-normal">Unresolved</span>
                            </div>
                        </td>
                        <td class="px-5 py-4 text-right">
                            <div class="flex gap-7 justify-end text-right">
                                <span class="material-symbols-outlined text-[#707070] cursor-pointer hover:text-[#151515]">description</span>
                                <span class="material-symbols-outlined text-[#707070] cursor-pointer hover:text-red-500">delete</span>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="flex justify-center items-center gap-2 mt-7">
            <span class="material-symbols-outlined text-[#707070] cursor-pointer hover:text-[#151515]">keyboard_double_arrow_left</span>
            <span class="material-symbols-outlined text-[#707070] cursor-pointer hover:text-[#151515]">keyboard_arrow_left</span>
            <input
                type="text"
                value="3"
                class="w-[46px] h-[37px] border border-[#EBEBED] rounded-[6px] text-center text-sm font-normal text-[#151515]
                    focus:outline-none focus:border-[#688CBA] transition-colors"/>
            <span class="text-sm font-normal text-[#151515] leading-[21px] tracking-normal">of 27</span>
            <span class="material-symbols-outlined text-[#707070] cursor-pointer hover:text-[#151515]">keyboard_arrow_right</span>
            <span class="material-symbols-outlined text-[#707070] cursor-pointer hover:text-[#151515]">keyboard_double_arrow_right</span>
        </div>
    </div>
{% endblock %}