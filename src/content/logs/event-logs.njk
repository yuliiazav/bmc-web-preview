---
permalink: /event-logs/
---
{% extends "../../_includes/index.njk" %}
{% from "macros/status.njk" import status_badge %}
{% from "macros/search.njk" import search_input %}
{# The toggle switch is a macro defined in src/_includes/macros/toggle.njk #}
{% from "macros/toggle.njk" import toggle_switch %}
{% block content %}
    <div class="mx-auto">
        <div class="flex justify-between items-center mb-12">
            <div>
                <h1 class="text-[32px] font-medium text-black leading-[130%] tracking-normal mb-2">Event logs</h1>
            </div>

            {# Date filter #}
            <div class="flex gap-6">
                <div class="flex flex-col gap-2">
                    <span class="text-md font-normal text-custom-text leading-[1.5]">From date</span>
                    <div class="relative">
                        <input type="text" placeholder="YYYY-MM-DD"
                            class="w-[200px] border border-custom-divider rounded-full px-[42px] py-3 text-xs leading-none font-normal text-custom-text 
                                   placeholder-custom-aside-text focus:outline-none focus:border-brand-blue transition-colors"/>
                        <span class="material-symbols-outlined absolute left-5 top-1/2 -translate-y-1/2 text-custom-aside-text text-[14px]">
                            calendar_today</span>
                    </div>
                </div>
                <div class="flex flex-col gap-2">
                    <span class="text-md font-normal text-custom-text leading-[1.5]">To date</span>
                    <div class="relative">
                        <input type="text" placeholder="YYYY-MM-DD"
                            class="w-[200px] border border-custom-divider rounded-full px-[42px] py-3 text-xs leading-none font-normal text-custom-text 
                                   placeholder-custom-aside-text focus:outline-none focus:border-brand-blue transition-colors"/>
                        <span class="material-symbols-outlined absolute left-5 top-1/2 -translate-y-1/2 text-custom-aside-text text-[14px]">
                            calendar_today</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="flex justify-between items-center mb-3 pr-2">

            {# Search #}
            {{ search_input(id="logSearch", placeholder="Search logs") }}
            {# Filter #}
            <div class="relative inline-block">
                <input type="checkbox" id="filter-menu-toggle" class="peer hidden"/>
                <label
        for="filter-menu-toggle"
        class="flex items-center gap-2 text-custom-text cursor-pointer select-none hover:text-brand-blue transition-colors
               peer-checked:text-brand-blue">
                    <span>{% include "../../assets/icons/icon-filter.svg" %}</span>
                    <span class="text-md font-normal leading-none tracking-normal">Filter</span>
                </label>

                {# Dropdown Menu #}
                <div class="hidden peer-checked:flex absolute right-0 mt-2 w-[180px] flex-col bg-white rounded-[20px] shadow-lg z-50 p-4 gap-4 border border-custom-divider">

                    {# Section: Type #}
                    <div class="flex flex-col gap-2">
                        <span class="text-sm font-bold text-custom-text leading-[21px] tracking-normal">Type</span>
                        <div class="flex flex-col gap-2">
                            <label class="flex items-center gap-2 cursor-pointer group">
                                <input type="checkbox" class="w-4 h-4 rounded border-custom-border cursor-pointer accent-brand-blue"/>
                                <span class="text-[12px] leading-[21px] font-normal text-custom-text group-hover:text-black">Ok</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer group">
                                <input type="checkbox" class="w-4 h-4 rounded border-custom-border cursor-pointer accent-brand-blue"/>
                                <span class="text-[12px] leading-[21px] font-normal text-custom-text group-hover:text-black">Warning</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer group">
                                <input type="checkbox" class="w-4 h-4 rounded border-custom-border cursor-pointer accent-brand-blue"/>
                                <span class="text-[12px] leading-[21px] font-normal text-custom-text group-hover:text-black">Critical</span>
                            </label>
                        </div>
                    </div>

                    {# Section: Status #}
                    <div class="flex flex-col gap-2">
                        <span class="text-sm font-normal text-custom-text leading-[21px] tracking-normal">Status</span>
                        <div class="flex flex-col gap-2">
                            <label class="flex items-center gap-2 cursor-pointer group">
                                <input type="checkbox" class="w-4 h-4 rounded border-custom-border cursor-pointer accent-brand-blue"/>
                                <span class="text-[12px] leading-[21px] font-normal text-custom-text group-hover:text-black">Resolved</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer group">
                                <input type="checkbox" class="w-4 h-4 rounded border-custom-border cursor-pointer accent-brand-blue"/>
                                <span class="text-[12px] leading-[21px] font-normal text-custom-text group-hover:text-black">Unresolved</span>
                            </label>
                        </div>
                    </div>

                    <button type="button" class="text-left text-[12px] leading-[18px] font-normal text-brand-blue hover:underline mt-1">
            Delete all
        </button>
                </div>
            </div>
        </div>
        {# Table #}
        <div class="bg-white border border-custom-divider overflow-hidden">
            <table class="w-full text-left border-collapse">
                <thead class="bg-custom-light-bg border-b border-custom-divider sticky top-0 z-10">
                    <tr>
                        <th class="px-4 py-5 w-10"></th>
                        <th class="px-2 py-5 w-8">
                            <input type="checkbox" class="w-4 h-4 rounded border-custom-divider text-brand-blue focus:ring-brand-blue"/>
                        </th>
                        <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none">ID</th>
                        <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none">Severity</th>
                        <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none">Date</th>
                        <th class="px-4 py-5 text-sm font-medium text-custom-text leading-none">Description</th>
                        <th class="px-4 py-5 w-[180px] text-sm font-medium text-custom-text leading-none">Status</th>
                        <th class="px-5 py-5 w-[108px]"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-custom-divider">

                    {# Row: Warning #}
                    <tr class="hover:bg-brand-blue/5 transition-colors">
                        <td class="px-4 py-4 text-center">
                            <span class="material-symbols-outlined text-custom-aside-text text-[24px] cursor-pointer">keyboard_arrow_down</span>
                        </td>
                        <td class="px-2 py-4">
                            <input type="checkbox" class="w-4 h-4 rounded border-custom-divider"/>
                        </td>
                        <td class="px-4 py-4">
                            <a href="#" class="text-sm font-normal text-custom-accent underline decoration-1 underline-offset-[2px]">1760121543</a>
                        </td>
                        <td class="px-4 py-4">
                            {{ status_badge('Warning') }}
                        </td>
                        <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3]">
                            2025-10-10<br/>
                            <span class="text-custom-aside-text text-xs">18:39:03 UTC</span>
                        </td>
                        <td class="px-4 py-4 text-md font-normal text-custom-text leading-[21px] max-w-[300px] break-words">
                            Service systemd-networkd-networkd-wait-online.service has exited with warnings.
                        </td>
                        <td class="px-4 py-4">
                            {# Toggle switch #}
                            {{ toggle_switch(id="statusLogsToggle", label_text="Unresolved", checked=false) }}
                        </td>
                        <td class="px-5 py-4">
                            <div class="flex gap-7 justify-end">
                                <span class="flex items-center justify-center w-5 h-5 shrink-0 cursor-pointer text-custom-aside-text hover:text-black transition-colors">
                                    {% include "src/assets/icons/icon-download.svg" %}
                                </span>
                                <span class="flex items-center justify-center w-5 h-5 shrink-0 cursor-pointer text-custom-aside-text hover:text-red-500 transition-colors">
                                    {% include "src/assets/icons/icon-delete.svg" %}
                                </span>
                            </div>
                        </td>
                    </tr>

                    {# Row: Critical #}
                    <tr class="hover:bg-brand-blue/5 transition-colors">
                        <td class="px-4 py-4 text-center">
                            <span class="material-symbols-outlined text-custom-aside-text text-[24px] cursor-pointer">keyboard_arrow_down</span>
                        </td>
                        <td class="px-2 py-4">
                            <input type="checkbox" class="w-4 h-4 rounded border-custom-divider"/>
                        </td>
                        <td class="px-4 py-4">
                            <a href="#" class="text-sm font-normal text-custom-accent underline decoration-1 underline-offset-[2px]">17601256756</a>
                        </td>
                        <td class="px-4 py-4">
                            {{ status_badge('Critical') }}
                        </td>
                        <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3]">
                            2025-10-10<br/>
                            <span class="text-custom-aside-text text-xs">18:39:03 UTC</span>
                        </td>
                        <td class="px-4 py-4 text-md font-normal text-custom-text leading-[21px] max-w-[300px] break-words">
                            Service systemd-networkd-networkd-wait-online.service has exited unsuccessfully.
                        </td>
                        <td class="px-4 py-4">
                            {# Toggle switch #}
                            {{ toggle_switch(id="statusLogsToggle", label_text="Resolved", checked=true) }}
                        </td>
                        <td class="px-5 py-4">
                            <div class="flex gap-7 justify-end">
                                <span class="flex items-center justify-center w-5 h-5 shrink-0 cursor-pointer text-custom-aside-text hover:text-black transition-colors">
                                    {% include "src/assets/icons/icon-download.svg" %}
                                </span>
                                <span class="flex items-center justify-center w-5 h-5 shrink-0 cursor-pointer text-custom-aside-text hover:text-red-500 transition-colors">
                                    {% include "src/assets/icons/icon-delete.svg" %}
                                </span>
                            </div>
                        </td>
                    </tr>
                    {# Row: Ok status #}
                    <tr class="hover:bg-brand-blue/5 transition-colors">
                        <td class="px-4 py-4 text-center">
                            <span class="material-symbols-outlined text-custom-aside-text text-[24px] cursor-pointer">keyboard_arrow_down</span>
                        </td>
                        <td class="px-2 py-4">
                            <input type="checkbox" class="w-4 h-4 rounded border-custom-divider"/>
                        </td>
                        <td class="px-4 py-4">
                            <a href="#" class="text-sm font-normal text-custom-accent underline decoration-1 underline-offset-[2px]">17601256756</a>
                        </td>
                        <td class="px-4 py-4">
                            {{ status_badge('Ok') }}
                        </td>
                        <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3]">
                            2025-10-10<br/>
                            <span class="text-custom-aside-text text-xs">18:39:03 UTC</span>
                        </td>
                        <td class="px-4 py-4 text-md font-normal text-custom-text leading-[21px] max-w-[300px] break-words">
                            Service systemd-networkd-networkd-wait-online.service has exited successfully.
                        </td>
                        <td class="px-4 py-4">
                            {# Toggle switch #}
                            {{ toggle_switch(id="statusLogsToggle", label_text="Resolved", checked=true) }}
                        </td>
                        <td class="px-5 py-4">
                            <div class="flex gap-7 justify-end">
                                <span class="flex items-center justify-center w-5 h-5 shrink-0 cursor-pointer text-custom-aside-text hover:text-black transition-colors">
                                    {% include "src/assets/icons/icon-download.svg" %}
                                </span>
                                <span class="flex items-center justify-center w-5 h-5 shrink-0 cursor-pointer text-custom-aside-text hover:text-red-500 transition-colors">
                                    {% include "src/assets/icons/icon-delete.svg" %}
                                </span>
                            </div>
                        </td>
                    </tr>
                    {# Row: Critical #}
                    <tr class="hover:bg-brand-blue/5 transition-colors">
                        <td class="px-4 py-4 text-center">
                            <span class="material-symbols-outlined text-custom-aside-text text-[24px] cursor-pointer">keyboard_arrow_down</span>
                        </td>
                        <td class="px-2 py-4">
                            <input type="checkbox" class="w-4 h-4 rounded border-custom-divider"/>
                        </td>
                        <td class="px-4 py-4">
                            <a href="#" class="text-sm font-normal text-custom-accent underline decoration-1 underline-offset-[2px]">17601256756</a>
                        </td>
                        <td class="px-4 py-4">
                            {{ status_badge('Critical') }}
                        </td>
                        <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3]">
                            2025-10-10<br/>
                            <span class="text-custom-aside-text text-xs">18:39:03 UTC</span>
                        </td>
                        <td class="px-4 py-4 text-md font-normal text-custom-text leading-[21px] max-w-[300px] break-words">
                            Service systemd-networkd-networkd-wait-online.service has exited unsuccessfully.
                        </td>
                        <td class="px-4 py-4">
                            {# Toggle switch #}
                            {{ toggle_switch(id="statusLogsToggle", label_text="Resolved", checked=true) }}
                        </td>
                        <td class="px-5 py-4">
                            <div class="flex gap-7 justify-end">
                                <span class="flex items-center justify-center w-5 h-5 shrink-0 cursor-pointer text-custom-aside-text hover:text-black transition-colors">
                                    {% include "src/assets/icons/icon-download.svg" %}
                                </span>
                                <span class="flex items-center justify-center w-5 h-5 shrink-0 cursor-pointer text-custom-aside-text hover:text-red-500 transition-colors">
                                    {% include "src/assets/icons/icon-delete.svg" %}
                                </span>
                            </div>
                        </td>
                    </tr>
                    {# Row: Ok status #}
                    <tr class="hover:bg-brand-blue/5 transition-colors">
                        <td class="px-4 py-4 text-center">
                            <span class="material-symbols-outlined text-custom-aside-text text-[24px] cursor-pointer">keyboard_arrow_down</span>
                        </td>
                        <td class="px-2 py-4">
                            <input type="checkbox" class="w-4 h-4 rounded border-custom-divider"/>
                        </td>
                        <td class="px-4 py-4">
                            <a href="#" class="text-sm font-normal text-custom-accent underline decoration-1 underline-offset-[2px]">17601256756</a>
                        </td>
                        <td class="px-4 py-4">
                            {{ status_badge('Ok') }}
                        </td>
                        <td class="px-4 py-4 text-sm font-normal text-custom-text leading-[1.3]">
                            2025-10-10<br/>
                            <span class="text-custom-aside-text text-xs">18:39:03 UTC</span>
                        </td>
                        <td class="px-4 py-4 text-md font-normal text-custom-text leading-[21px] max-w-[300px] break-words">
                            Service systemd-networkd-networkd-wait-online.service has exited successfully.
                        </td>
                        <td class="px-4 py-4">
                            {# Toggle switch #}
                            {{ toggle_switch(id="statusLogsToggle", label_text="Resolved", checked=true) }}
                        </td>
                        <td class="px-5 py-4">
                            <div class="flex gap-7 justify-end">
                                <span class="flex items-center justify-center w-5 h-5 shrink-0 cursor-pointer text-custom-aside-text hover:text-black transition-colors">
                                    {% include "src/assets/icons/icon-download.svg" %}
                                </span>
                                <span class="flex items-center justify-center w-5 h-5 shrink-0 cursor-pointer text-custom-aside-text hover:text-red-500 transition-colors">
                                    {% include "src/assets/icons/icon-delete.svg" %}
                                </span>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        {# Pagination #}
        <div class="flex justify-center items-center gap-2 mt-7">
            <span class="material-symbols-outlined text-custom-aside-text cursor-pointer hover:text-black">keyboard_double_arrow_left</span>
            <span class="material-symbols-outlined text-custom-aside-text cursor-pointer hover:text-black">keyboard_arrow_left</span>
            <input type="text" value="3"
                class="w-12 h-9 border border-custom-divider rounded-md text-center text-sm font-normal text-custom-text focus:outline-none focus:border-brand-blue transition-colors"/>
            <span class="text-sm font-normal text-custom-text">of 27</span>
            <span class="material-symbols-outlined text-custom-aside-text cursor-pointer hover:text-black">keyboard_arrow_right</span>
            <span class="material-symbols-outlined text-custom-aside-text cursor-pointer hover:text-black">keyboard_double_arrow_right</span>
        </div>
    </div>
{% endblock %}