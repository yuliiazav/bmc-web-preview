<header class="bg-white flex flex-col pt-9 pl-6 pr-10 gap-2 text-custom-text">
    <div class="flex items-center justify-end gap-3">
        <div class="flex items-center gap-3">
            {% set badgeClass = "flex items-center gap-2 px-4 py-2 border border-custom-border rounded-full font-normal text-sm bg-white cursor-pointer hover:bg-custom-light-bg transition-all active:scale-95 outline-none focus:ring-1 focus:ring-brand-blue" %}

            <a href="/manage-ipdesk/" id="header-appHeader-remotehost" class="{{ badgeClass }}">
                <span class="flex items-center justify-center shrink-0">
                    {% include "src/assets/icons/icon-appHeader-remotehost.svg" %}
                </span>
                <span class="truncate">reboot IPDesk</span>
            </a>
        </div>

        <button type="button" id="header-refresh-btn" class="{{ badgeClass }}">
            <span class="flex items-center justify-center">
                {% include "src/assets/icons/icon-refresh.svg" %}
            </span>
            Refresh
        </button>

        <div class="relative">
            <input type="checkbox" id="user-menu-toggle" class="peer hidden"/>
            <label for="user-menu-toggle" id="user-menu-label"
                   class="flex items-center px-3 py-2 gap-2 border border-custom-border rounded-full font-normal text-sm cursor-pointer hover:bg-custom-light-bg transition-colors select-none peer-checked:bg-custom-light-bg">
                <span class="flex items-center justify-center">
                    {% include "src/assets/icons/icon-avatar.svg" %}
                </span>
                <span id="header-username-display">Username</span>
                <span class="flex items-center justify-center transition-transform duration-200 peer-checked:rotate-180">
                    {% include "src/assets/icons/icon-arrow-down.svg" %}
                </span>
            </label>

            <div id="user-dropdown-menu" 
                 class="w-[150px] hidden peer-checked:flex absolute gap-2 right-0 mt-1 flex-col bg-white border border-custom-divider rounded-[20px] shadow-md z-50 py-4 px-4">
                <a href="/profile-settings/" id="link-profile-settings" class="text-[12px] text-custom-text hover:text-brand-blue transition-colors">
                    Profile settings
                </a>
                <hr class="border-custom-divider opacity-50">
                <a href="/login/" id="link-logout" class="text-[12px] text-red-600 hover:font-bold transition-all">
                    Log out
                </a>
            </div>
        </div>
    </div>

    <div class="w-full border-b border-custom-divider mt-2"></div>
</header>