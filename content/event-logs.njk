---
permalink: "/event-logs/"
---
{% extends "../index.njk" %}
{% block content %}
    <div class="mx-auto text-custom-text">
        {# Page title and date #}
        <div class="flex justify-between items-end mb-8">
            <h1 class="text-[32px] font-medium leading-tight">Event logs</h1>

            <div class="flex gap-4">
                <div class="flex flex-col gap-1">
                    <label class="text-[10px] font-medium text-custom-aside-text uppercase tracking-wider">From date</label>
                    <div class="relative group">
                        <input type="text" placeholder="YYYY-MM-DD" 
                           class="border border-custom-divider rounded-md px-3 py-2 text-sm w-[180px] focus:outline-none focus:border-brand-blue bg-white">
                        <span class="material-symbols-outlined absolute right-2 top-2 text-gray-400 text-[18px]">calendar_today</span>
                    </div>
                </div>
                <div class="flex flex-col gap-1">
                    <label class="text-[10px] font-medium text-custom-aside-text uppercase tracking-wider">To date</label>
                    <div class="relative group">
                        <input type="text" placeholder="YYYY-MM-DD" 
                           class="border border-custom-divider rounded-md px-3 py-2 text-sm w-[180px] focus:outline-none focus:border-brand-blue bg-white">
                        <span class="material-symbols-outlined absolute right-2 top-2 text-gray-400 text-[18px]">calendar_today</span>
                    </div>
                </div>
            </div>
        </div>

        {# Search #}
        <div class="relative mb-6">
            <span class="material-symbols-outlined absolute left-3 top-2.5 text-gray-400 text-[20px]">search</span>
            <input type="text" placeholder="Search logs" 
               class="pl-10 pr-4 py-2 border border-custom-divider rounded-full text-sm w-[320px] focus:outline-none focus:border-brand-blue bg-white shadow-sm">
        </div>

        {# Table #}
        <div class="bg-white border border-custom-divider rounded-md overflow-hidden shadow-sm">
            <table class="w-full text-left border-collapse">
                <thead class="bg-[#F9FAFB] border-b border-custom-divider">
                    <tr>
                        <th class="w-12 px-4 py-3"></th>
                        {# For arrow #}
                        <th class="w-10 px-2 py-3"><input type="checkbox" class="accent-brand-blue"></th>
                        <th class="px-4 py-3 text-[11px] font-bold text-custom-aside-text uppercase tracking-wider">ID</th>
                        <th class="px-4 py-3 text-[11px] font-bold text-custom-aside-text uppercase tracking-wider">Severity</th>
                        <th class="px-4 py-3 text-[11px] font-bold text-custom-aside-text uppercase tracking-wider">Date</th>
                        <th class="px-4 py-3 text-[11px] font-bold text-custom-aside-text uppercase tracking-wider w-1/3">Description</th>
                        <th class="px-4 py-3 text-[11px] font-bold text-custom-aside-text uppercase tracking-wider text-center">Status</th>
                        <th class="px-4 py-3"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-custom-divider">
                    {#  Warning #}
                    <tr class="hover:bg-gray-50/80 transition-colors">
                        <td class="px-4 text-center">
                            <span class="material-symbols-outlined text-gray-400 cursor-pointer">expand_more</span></td>
                        <td class="px-2 py-4"><input type="checkbox"></td>
                        <td class="px-4 py-4">
                            <a href="#" class="text-brand-blue hover:underline font-medium">1760121543</a>
                        </td>
                        <td class="px-4 py-4">
                            <span class="inline-flex items-center gap-1 px-2 py-1 rounded border border-amber-200 bg-amber-50 text-amber-700 text-[10px] font-bold uppercase tracking-tight">
                                <span class="material-symbols-outlined text-[14px] font-fill">warning</span> Warning
                        </span>
                        </td>
                        <td class="px-4 py-4 text-[13px] text-custom-aside-text leading-tight">2025-10-10<br>18:39:03 UTC</td>
                        <td class="px-4 py-4 text-[13px] leading-snug">Service systemd-networkd-wait-online.service has exited unsuccessfully.</td>
                        <td class="px-4 py-4">
                            <div class="flex items-center justify-center gap-2">
                                <label class="relative inline-flex items-center cursor-pointer transform scale-90">
                                    <input type="checkbox" class="sr-only peer">
                                    <div class="w-10 h-5 bg-gray-200 rounded-full peer peer-checked:bg-brand-blue after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:after:translate-x-5"></div>
                                </label>
                                <span class="text-[12px] text-custom-aside-text min-w-[70px]">Unresolved</span>
                            </div>
                        </td>
                        <td class="px-4 py-4">
                            <div class="flex items-center gap-3 text-gray-400">
                                <button class="hover:text-brand-blue transition-colors">
                                    <span class="material-symbols-outlined text-[20px]">description</span></button>
                                <button class="hover:text-red-500 transition-colors">
                                    <span class="material-symbols-outlined text-[20px]">delete</span></button>
                            </div>
                        </td>
                    </tr>

                    {#  Critical #}
                    <tr class="hover:bg-gray-50/80 transition-colors">
                        <td class="px-4 text-center">
                            <span class="material-symbols-outlined text-gray-400 cursor-pointer">expand_more</span></td>
                        <td class="px-2 py-4"><input type="checkbox"></td>
                        <td class="px-4 py-4">
                            <a href="#" class="text-brand-blue hover:underline font-medium">1760125678</a>
                        </td>
                        <td class="px-4 py-4">
                            <span class="inline-flex items-center gap-1 px-2 py-1 rounded border border-red-200 bg-red-50 text-red-700 text-[10px] font-bold uppercase tracking-tight">
                                <span class="material-symbols-outlined text-[14px] font-fill">cancel</span> Critical
                        </span>
                        </td>
                        <td class="px-4 py-4 text-[13px] text-custom-aside-text">2025-10-10<br>18:40:12 UTC</td>
                        <td class="px-4 py-4 text-[13px] leading-snug">Critical hardware error detected on Sensor "CPU Temperature".</td>
                        <td class="px-4 py-4">
                            <div class="flex items-center justify-center gap-2">
                                {# Analog toggle #}
                                <div class="w-10 h-5 bg-gray-200 rounded-full"></div>
                                <span class="text-[12px] text-custom-aside-text">Unresolved</span>
                            </div>
                        </td>
                        <td class="px-4 py-4">...</td>
                    </tr>
                </tbody>
            </table>
        </div>

        {# Pagination #}
        <div class="flex justify-center items-center gap-4 mt-8">
            <div class="flex items-center gap-1">
                <button class="w-8 h-8 flex items-center justify-center text-gray-400 hover:text-custom-text transition-colors">
                    <span class="material-symbols-outlined">first_page</span></button>
                <button class="w-8 h-8 flex items-center justify-center text-gray-400 hover:text-custom-text transition-colors">
                    <span class="material-symbols-outlined">chevron_left</span></button>
            </div>
            <div class="flex items-center gap-2">
                <input type="text" value="3" class="w-10 h-8 border border-custom-divider rounded text-center text-sm font-medium">
                <span class="text-sm text-custom-aside-text whitespace-nowrap">of 27</span>
            </div>
            <div class="flex items-center gap-1">
                <button class="w-8 h-8 flex items-center justify-center text-brand-blue hover:text-custom-accent transition-colors">
                    <span class="material-symbols-outlined font-bold">chevron_right</span></button>
                <button class="w-8 h-8 flex items-center justify-center text-brand-blue hover:text-custom-accent transition-colors">
                    <span class="material-symbols-outlined font-bold">last_page</span></button>
            </div>
        </div>
    </div>
{% endblock %}