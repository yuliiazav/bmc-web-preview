{% extends "../index.njk" %}
{% block content %}
    <div class="mx-auto">
        <h1 class="text-[32px] font-medium text-[#1D1D1F] leading-[130%] tracking-normal mb-2">Overview</h1>
        <div class="bg-white border border-[#E0E0E0] rounded-md p-4 mb-14 flex justify-between items-center">
            <div>
                <p class="text-sm font-medium text-[#151515] leading-[1.5] mb-1">BMC date and Time</p>
                <p class="text-sm font-normal text-[#151515] leading-[1.5]">2025-10-14 12:43 UTC</p>
            </div>
            <button class="bg-[#688CBA] hover:bg-[#5779a5] text-white px-8 py-2 rounded-[28px] flex items-center gap-2 transition-colors">
                <span class="text-sm font-medium leading-[120%]">SOL console</span>
                <span class="material-symbols-outlined text-[24px]">chevron_right</span>
            </button>
        </div>
        <section class="mb-14">
            <h2 class="text-xl font-medium text-[#1D1D1F] leading-[130%] mb-4">System information</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
                <div class="bg-white border border-[#E0E0E0] rounded-md overflow-hidden">
                    <div class="flex justify-between items-center px-4 py-3 border-b border-[#E0E0E0]">
                        <span class="text-sm font-medium text-[#151515] leading-[1.5]">BMC date and Time</span>
                        <a href="#" class="text-sm font-medium text-[#6090C2] leading-[120%] hover:underline transition-all">View more</a>
                    </div>
                    <div class="px-4 py-3 grid grid-cols-2 gap-x-4 gap-y-3">
                        <div>
                            <p class="text-sm font-medium text-[#151515] leading-[1.5] mb-1">Model</p>
                            <p class="text-sm font-normal text-[#151515] leading-[1.5]">--</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-[#151515] leading-[1.5] mb-1">Server manufacturer</p>
                            <p class="text-sm font-normal text-[#151515] leading-[1.5]">--</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-[#151515] leading-[1.5] mb-1">Serial number</p>
                            <p class="text-sm font-normal text-[#151515] leading-[1.5]">--</p>
                        </div>
                    </div>
                </div>
                <div class="bg-white border border-[#E0E0E0] rounded-md overflow-hidden">
                    <div class="flex justify-between items-center px-4 py-3 border-b border-[#E0E0E0]">
                        <span class="text-sm font-medium text-[#151515] leading-[1.5]">Firmware information</span>
                        <a href="#" class="text-sm font-medium text-[#6090C2] leading-[120%] hover:underline transition-all">View more</a>
                    </div>
                    <div class="px-4 py-3 grid grid-cols-2 gap-x-4 gap-y-3">
                        <div class="col-span-1">
                            <p class="text-sm font-medium text-[#151515] leading-[1.5] mb-1">Running</p>
                            <p class="text-sm font-normal text-[#151515] leading-[1.5]">v09.05-21-ge66c49cdfe-dirty</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-[#151515] leading-[1.5] mb-1">Firmware version</p>
                            <p class="text-sm font-normal text-[#151515] leading-[1.5]">--</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-[#151515] leading-[1.5] mb-1">Backup</p>
                            <p class="text-sm font-normal text-[#151515] leading-[1.5]">--</p>
                        </div>
                    </div>
                </div>
                <div class="bg-white border border-[#E0E0E0] rounded-md overflow-hidden">
                    <div class="flex justify-between items-center px-4 py-3 border-b border-[#E0E0E0]">
                        <span class="text-sm font-medium text-[#151515] leading-[1.5]">Network information</span>
                        <a href="#" class="text-sm font-medium text-[#6090C2] leading-[120%] hover:underline transition-all">View more</a>
                    </div>
                    <div class="px-4 py-3 grid grid-cols-2 gap-x-4 gap-y-3">
                        <div>
                            <p class="text-sm font-medium text-[#151515] leading-[1.5] mb-1">Hostname</p>
                            <p class="text-sm font-normal text-[#151515] leading-[1.5]">ast2600-default</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-[#151515] leading-[1.5] mb-1">Link status</p>
                            <p class="text-sm font-normal text-[#151515] leading-[1.5]">NoLink</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-[#151515] leading-[1.5] mb-1">IPv4</p>
                            <p class="text-sm font-normal text-[#151515] leading-[1.5]">--</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-[#151515] leading-[1.5] mb-1">DHCPv4</p>
                            <p class="text-sm font-normal text-[#151515] leading-[1.5]">--</p>
                        </div>
                    </div>
                </div>
                <div class="bg-white border border-[#E0E0E0] rounded-md overflow-hidden">
                    <div class="flex justify-between items-center px-4 py-3 border-b border-[#E0E0E0]">
                        <span class="text-sm font-medium text-[#151515] leading-[1.5]">Power information</span>
                        <a href="#" class="text-sm font-medium text-[#6090C2] leading-[120%] hover:underline transition-all">View more</a>
                    </div>
                    <div class="px-4 py-3 flex flex-col gap-y-3">
                        <div>
                            <p class="text-sm font-medium text-[#151515] leading-[1.5] mb-1">Power consumption</p>
                            <p class="text-sm font-normal text-[#151515] leading-[1.5]">Not available</p>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-[#151515] leading-[1.5] mb-1">Power cap</p>
                            <p class="text-sm font-normal text-[#151515] leading-[1.5]">Disabled</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <section class="mb-[62px]">
            <h2 class="text-xl font-medium text-[#1D1D1F] leading-[130%] mb-4">Status information</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-white border border-[#E0E0E0] rounded-md overflow-hidden">
                    <div class="flex justify-between items-center px-4 py-3 border-b border-[#E0E0E0]">
                        <span class="text-sm font-medium text-[#151515] leading-[1.5]">Event logs</span>
                        <div class="flex items-center gap-2">
                            <a href="#" class="text-sm font-medium text-[#6090C2] leading-[120%] hover:underline transition-all">Export All</a>
                            <div class="w-[1px] h-[21px] bg-[#E0E0E0]"></div>
                            <a href="#" class="text-sm font-medium text-[#6090C2] leading-[120%] hover:underline transition-all">View more</a>
                        </div>
                    </div>
                    <div class="px-4 py-3 grid grid-cols-2 gap-x-4">
                        <div>
                            <p class="text-sm font-medium text-[#151515] leading-[1.5] mb-1">Critical</p>
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-normal text-[#151515] leading-none">12</span>
                                <span class="material-symbols-outlined text-red-600 text-[16px]">cancel</span>
                            </div>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-[#151515] leading-[1.5] mb-1">Warning</p>
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-normal text-[#151515] leading-none">36</span>
                                <span class="material-symbols-outlined text-amber-500 font-fill text-[16px]">error</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="bg-white border border-[#E0E0E0] rounded-md overflow-hidden">
                    <div class="flex justify-between items-center px-4 py-3 border-b border-[#E0E0E0]">
                        <span class="text-sm font-medium text-[#151515] leading-[1.5]">Inventory and LEDs</span>
                        <a href="#" class="text-sm font-medium text-[#6090C2] leading-[120%] hover:underline transition-all">View more</a>
                    </div>
                    <div class="px-4 py-3">
                        <p class="text-sm font-medium text-[#151515] leading-[1.5] mb-1">System identify LED</p>
                        <div class="flex items-center gap-2">
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" class="sr-only peer"/>
                                <div class="w-[40px] h-[24px] bg-white border border-[#C7C7C7] rounded-full peer peer-focus:outline-none
                                    peer-checked:bg-[#688CBA] peer-checked:border-[#688CBA] transition-all /* Circle (14x14) */ after:content-['']
                                    after:absolute after:top-[5px] after:left-[4px] after:w-[14px] after:h-[14px] after:bg-[#707070] after:rounded-full
                                    after:transition-all /* Click state */ peer-checked:after:bg-white peer-checked:after:translate-x-[18px] /* Checkmark */
                                    before:content-['check'] before:font-['Material_Symbols_Outlined'] before:absolute before:left-[6px] before:top-[6px]
                                    before:text-white before:text-[12px] before:leading-none before:opacity-0 peer-checked:before:opacity-100
                                    before:transition-opacity"></div>
                            </label>
                            <span class="text-sm font-normal text-[#151515] leading-[1.5]">Off</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
{% endblock %}